# %bitselect_i32
fn main v0:i32 v1:i32 v2:i32 -> i32
  t0 = xor v1 v2
  t1 = and v0 t0
  v3 = xor v2 t1
  ret v3
@run 0 0 0xFFFFFFFF -> 0xFFFFFFFF
@run 0x55555555 0 0xFFFFFFFF -> 0xAAAAAAAA
@run 0xFFFFFFFF 0xFFFFFFFF 0 -> 0xFFFFFFFF
