# %a
fn main v0:i32 v1:i32 -> i32
  v2 = const 0
  v3 = const 1
  v4 = shl v0 v1
  t0 = eq v4 v2
  t1 = const 1
  v5 = and t0 t1
  br v5 select_v6 v3 | select_v6 v4
block select_v6 v6:i32
  ret v6
@run 514 -1 -> 1
