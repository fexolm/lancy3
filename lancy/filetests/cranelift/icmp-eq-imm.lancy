# %icmp_imm_eq_i32
fn main v0:i32 -> i32
  t0 = const 1145324612
  t1 = eq v0 t0
  t2 = const 1
  v1 = and t1 t2
  ret v1
@run 0 -> 0
@run -1 -> 0
@run 0x4444_4444 -> 1

---

# %icmp_neg_eq_i32
fn main v0:i32 -> i32
  t0 = const -48060
  t1 = eq v0 t0
  t2 = const 1
  v1 = and t1 t2
  ret v1
@run 0 -> 0
@run -1 -> 0
@run 0xffff_4444 -> 1
