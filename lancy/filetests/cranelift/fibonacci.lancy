# %fibonacci
fn main v0:i32 -> i32
  t0 = const 2
  t1 = const -2147483648
  t2 = xor v0 t1
  t3 = xor t0 t1
  t4 = le t2 t3
  t5 = const 1
  v1 = and t4 t5
  v2 = const 1
  br v1 block3 v2 | block1 v0 v2
block block1 v4:i32 v5:i32
  v6 = const 1
  t6 = const -2
  v7 = add v4 t6
  jump block2 v7 v5 v6
block block2 v10:i32 v11:i32 v12:i32
  v13 = add v11 v12
  t7 = const -1
  v14 = add v10 t7
  t8 = const 0
  t9 = eq v14 t8
  t10 = const 1
  v15 = and t9 t10
  br v15 block3 v13 | block2 v14 v13 v11
block block3 v20:i32
  ret v20
@run 0 -> 1
@run 1 -> 1
@run 2 -> 1
@run 3 -> 2
@run 4 -> 3
@run 5 -> 5
@run 6 -> 8
@run 10 -> 55
