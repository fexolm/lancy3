# %iabs_i32
fn main(v0:i32) -> i32
  t0 = const 0
  t1 = sub t0 v0
  v1 = max v0 t1
  ret v1
@run 0 -> 0
@run 2147483647 -> 2147483647
@run -2147483647 -> 2147483647
@run -2147483648 -> -2147483648
