# %select_overflow_i32
fn main(v0:i32) -> i32
  v1 = const -1
  v2 = add v0 v1
  v3 = const 1
  v4 = const 0
  br v2 select_v5(v3) | select_v5(v4)
block select_v5(v5:i32)
  ret v5
@run 0 -> 1
@run 2 -> 1
@run 1 -> 0
@run 98 -> 1

---

# %select_icmp32_eq_imm
fn main(v0:i32 v1:i32 v2:i32) -> i32
  t0 = const 7
  t1 = eq v0 t0
  t2 = const 1
  v3 = and t1 t2
  br v3 select_v4(v1) | select_v4(v2)
block select_v4(v4:i32)
  ret v4
@run 7 42 35 -> 42
@run 0 42 35 -> 35
@run -1 42 35 -> 35

---

