  t0 = eq v0 v1
  t1 = const 1
  v2 = and t0 t1
  br v2 select_v3(v0) | select_v3(v1)
block select_v3(v3:i32)
  ret v3
@run 42 35 -> 35
@run 42 42 -> 42

