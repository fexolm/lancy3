# %simplify_select_slt_ne_i32
fn main(v0:i32 v1:i32) -> i32
  t0 = lt v0 v1
  t1 = const 1
  v2 = and t0 t1
  br v2 select_v3(v0) | select_v3(v1)
block select_v3(v3:i32)
  t2 = ne v3 v0
  t3 = const 1
  v4 = and t2 t3
  ret v4
@run 92 42 -> 1
@run 7 -8 -> 1
@run -79 42 -> 0
@run -1111111 42 -> 0

---

# %test_sgt_select_slt_min
fn main(v0:i32 v1:i32) -> i32
  t0 = lt v1 v0
  t1 = const 1
  v2 = and t0 t1
  br v2 select_v3(v1) | select_v3(v0)
block select_v3(v3:i32)
  t2 = gt v3 v0
  t3 = const 1
  v4 = and t2 t3
  ret v4
@run 42 444 -> 0

---

# %test_ugt_select_ult_min
fn main(v0:i32 v1:i32) -> i32
  t0 = const -2147483648
  t1 = xor v1 t0
  t2 = xor v0 t0
  t3 = lt t1 t2
  t4 = const 1
  v2 = and t3 t4
  br v2 select_v3(v1) | select_v3(v0)
block select_v3(v3:i32)
  t5 = const -2147483648
  t6 = xor v3 t5
  t7 = xor v0 t5
  t8 = gt t6 t7
  t9 = const 1
  v4 = and t8 t9
  ret v4
@run 234234 5544 -> 0

