# %select_eq_xn_yminusn_yminusx_to_yminusx_rt
fn main(v0:i32 v1:i32) -> i32
  v2 = const 7
  t0 = eq v0 v2
  t1 = const 1
  v3 = and t0 t1
  v4 = sub v1 v2
  v5 = sub v1 v0
  br v3 select_v6(v4) | select_v6(v5)
block select_v6(v6:i32)
  ret v6
@run 7 10 -> 3
@run 3 10 -> 7
@run 0 10 -> 10
