# %icmp_sle_i32
fn main v0:i32 v1:i32 -> i32
  t0 = le v0 v1
  t1 = const 1
  v2 = and t0 t1
  ret v2
@run 0 0 -> 1
@run 1 0 -> 0
@run -1 -1 -> 1
@run 0 1 -> 1
@run -5 -1 -> 1
@run 1 -1 -> 0

---

# %icmp_sle_i32_imm
fn main v0:i32 -> i32
  t0 = const 10
  t1 = le v0 t0
  t2 = const 1
  v2 = and t1 t2
  ret v2
@run 10 -> 1
@run 0 -> 1
@run -1 -> 1
