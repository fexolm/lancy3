# %brif_value
fn main(v0:i32) -> i32
  br v0 block1() | block2()
block block1()
  t0 = const 255
  v1 = and v0 t0
  ret v1
block block2()
  v2 = const 42
  ret v2
@run 0 -> 42
@run 42 -> 42
@run 97 -> 97

---

# %brif_ne_zero
fn main(v0:i32) -> i32
  v1 = const 0
  t0 = ne v0 v1
  t1 = const 1
  v2 = and t0 t1
  br v2 block1() | block2()
block block1()
  t2 = const 255
  v3 = and v0 t2
  ret v3
block block2()
  v4 = const 42
  ret v4
@run 0 -> 42
@run 42 -> 42
@run 97 -> 97

---

# %brif_ne_one
fn main(v0:i32) -> i32
  v1 = const 1
  t0 = ne v0 v1
  t1 = const 1
  v2 = and t0 t1
  br v2 block1() | block2()
block block1()
  t2 = const 255
  v3 = and v0 t2
  ret v3
block block2()
  v4 = const 42
  ret v4
@run 1 -> 42
@run 0 -> 0
@run 42 -> 42
@run 97 -> 97

---

# %brif_uextend_ne_one
fn main(v0:i32) -> i32
  v1 = const 1
  t0 = ne v0 v1
  t1 = const 1
  v2 = and t0 t1
  t2 = const 255
  v3 = and v2 t2
  br v3 block1() | block2()
block block1()
  t3 = const 255
  v4 = and v0 t3
  ret v4
block block2()
  v5 = const 42
  ret v5
@run 1 -> 42
@run 0 -> 0
@run 42 -> 42
@run 97 -> 97

---

# %brif_i32
fn main(v0:i32) -> i32
  br v0 block1() | block2()
block block1()
  v1 = const 1
  ret v1
block block2()
  v2 = const 0
  ret v2
@run 0 -> 0
@run 1 -> 1
@run -1 -> 1

---

# %brif_different_args
fn main(v0:i32) -> i32
  br v0 block1(v0 v0) | block2(v0)
block block1(v1:i32 v2:i32)
  v3 = add v1 v2
  ret v3
block block2(v4:i32)
  ret v4
@run 0 -> 0
@run 1 -> 2
@run 8 -> 16
@run -2147483648 -> 0

---

# %fuzzgen_1
fn main() -> i32
  v1 = const 35
  br v1 block1(v1) | block1(v1)
block block1(v0:i32)
  ret v0
@run -> 35

---

# %fuzzgen_3
fn main(v0:i32) -> i32
  v1 = const -9
  br v0 block1(v1) | block1(v0)
block block1(v2:i32)
  ret v2
@run -65 -> -9
@run 0 -> 0
