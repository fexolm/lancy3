# %br_table_i32
fn main(v0:i32) -> i32
  t0 = const 0
  t1 = eq v0 t0
  br t1 block1() | test1()
block test1()
  t2 = const 1
  t3 = eq v0 t2
  br t3 block2() | test2()
block test2()
  t4 = const 2
  t5 = eq v0 t4
  br t5 block2() | test3()
block test3()
  t6 = const 3
  t7 = eq v0 t6
  br t7 block3() | test4()
block test4()
  jump block4()
block block1()
  v1 = const 1
  jump block5(v1)
block block2()
  v2 = const 2
  jump block5(v2)
block block3()
  v3 = const 3
  jump block5(v3)
block block4()
  v4 = const 4
  jump block5(v4)
block block5(v5:i32)
  v6 = add v0 v5
  ret v6
@run 0 -> 1
@run 1 -> 3
@run 2 -> 4
@run 3 -> 6
@run 4 -> 8
@run 5 -> 9
@run 6 -> 10
@run -1 -> 3

---

# %br_table_i32_inline
fn main(v0:i32) -> i32
  v1 = const 1
  v2 = const 2
  v3 = const 3
  v4 = const 4
  t0 = const 0
  t1 = eq v0 t0
  br t1 block1(v1) | test1()
block test1()
  t2 = const 1
  t3 = eq v0 t2
  br t3 block1(v2) | test2()
block test2()
  t4 = const 2
  t5 = eq v0 t4
  br t5 block1(v2) | test3()
block test3()
  t6 = const 3
  t7 = eq v0 t6
  br t7 block1(v3) | test4()
block test4()
  jump block1(v4)
block block1(v5:i32)
  ret v5
@run 0 -> 1
@run 1 -> 2
@run 2 -> 2
@run 3 -> 3
@run 4 -> 4
@run 297 -> 4
@run 65535 -> 4

---

# %br_table_i32_inline_varied
fn main(v0:i32) -> i32
  v1 = const 1
  v2 = const 2
  v3 = const 3
  v4 = const 4
  t0 = const 0
  t1 = eq v0 t0
  br t1 block1(v1) | test1()
block test1()
  t2 = const 1
  t3 = eq v0 t2
  br t3 block2(v2 v4) | test2()
block test2()
  t4 = const 2
  t5 = eq v0 t4
  br t5 block2(v4 v3) | test3()
block test3()
  t6 = const 3
  t7 = eq v0 t6
  br t7 block1(v3) | test4()
block test4()
  jump block1(v4)
block block2(v6:i32 v7:i32)
  v8 = add v6 v7
  jump block1(v8)
block block1(v5:i32)
  ret v5
@run 0 -> 1
@run 1 -> 6
@run 2 -> 7
@run 3 -> 3
@run 4 -> 4
@run 297 -> 4
@run 65535 -> 4
