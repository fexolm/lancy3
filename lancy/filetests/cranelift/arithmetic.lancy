# %fold_bnot_iadd_const_i32_rt
fn main v0:i32 -> i32
  v1 = const 5
  v2 = add v0 v1
  t0 = const -1
  v3 = xor v2 t0
  ret v3
@run 0 -> -6
@run 7 -> -13
@run -5 -> -1
@run 0x7fffffff -> 0x7ffffffb

---

# %fold_bnot_iadd_neg_const_i64_rt (low 32 bits)
fn main v0:i32 -> i32
  v1 = const -7
  v2 = add v0 v1
  t0 = const -1
  v3 = xor v2 t0
  ret v3
@run 0 -> 6
@run 7 -> -1
@run -1 -> 7
@run 0 -> 6
