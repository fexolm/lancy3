# %test_sgt_x_smax
fn main v0:i32 v1:i32 -> i32
  v2 = max v0 v1
  t0 = gt v0 v2
  t1 = const 1
  v3 = and t0 t1
  ret v3
@run 0 0 -> 0
@run 1 2 -> 0

---

# %test_ugt_x_umax
fn main v0:i32 v1:i32 -> i32
  t0 = const -2147483648
  t1 = xor v0 t0
  t2 = xor v1 t0
  t3 = max t1 t2
  v2 = xor t3 t0
  t4 = const -2147483648
  t5 = xor v0 t4
  t6 = xor v2 t4
  t7 = gt t5 t6
  t8 = const 1
  v3 = and t7 t8
  ret v3
@run 0 0 -> 0
@run 1 2 -> 0

