# %isort3 (result 1)
fn main v0:i32 v1:i32 v2:i32 -> i32
  v3 = min v0 v1
  v4 = min v1 v2
  v5 = min v2 v0
  v6 = min v3 v4
  v7 = max v0 v1
  v8 = max v1 v2
  v9 = max v7 v8
  v10 = max v3 v4
  v11 = max v10 v5
  ret v6
@run 1 2 3 -> 1
@run 1 3 2 -> 1
@run 2 1 3 -> 1
@run 2 3 1 -> 1
@run 3 1 2 -> 1
@run 3 2 1 -> 1
@run -1 0 1 -> -1
@run -1 1 1 -> -1
@run -2 1 0 -> -2
@run 0 0 0 -> 0
@run 5 4 4 -> 4

---
# %isort3 (result 2)
fn main v0:i32 v1:i32 v2:i32 -> i32
  v3 = min v0 v1
  v4 = min v1 v2
  v5 = min v2 v0
  v6 = min v3 v4
  v7 = max v0 v1
  v8 = max v1 v2
  v9 = max v7 v8
  v10 = max v3 v4
  v11 = max v10 v5
  ret v11
@run 1 2 3 -> 2
@run 1 3 2 -> 2
@run 2 1 3 -> 2
@run 2 3 1 -> 2
@run 3 1 2 -> 2
@run 3 2 1 -> 2
@run -1 0 1 -> 0
@run -1 1 1 -> 1
@run -2 1 0 -> 0
@run 0 0 0 -> 0
@run 5 4 4 -> 4

---
# %isort3 (result 3)
fn main v0:i32 v1:i32 v2:i32 -> i32
  v3 = min v0 v1
  v4 = min v1 v2
  v5 = min v2 v0
  v6 = min v3 v4
  v7 = max v0 v1
  v8 = max v1 v2
  v9 = max v7 v8
  v10 = max v3 v4
  v11 = max v10 v5
  ret v9
@run 1 2 3 -> 3
@run 1 3 2 -> 3
@run 2 1 3 -> 3
@run 2 3 1 -> 3
@run 3 1 2 -> 3
@run 3 2 1 -> 3
@run -1 0 1 -> 1
@run -1 1 1 -> 1
@run -2 1 0 -> 1
@run 0 0 0 -> 0
@run 5 4 4 -> 5

---

# %smin_max_i32 (result 1)
fn main v0:i32 v1:i32 -> i32
  v2 = min v0 v1
  v3 = max v0 v1
  ret v2
@run -1 0 -> -1
@run 1 -1 -> -1
@run 1 2 -> 1
@run 2 1 -> 1
@run 0x7f 0x80 -> 0x7f
@run 0x7fff 0x8000 -> 0x7fff
@run 0x7fffffff 0x80000000 -> 0x80000000

---
# %smin_max_i32 (result 2)
fn main v0:i32 v1:i32 -> i32
  v2 = min v0 v1
  v3 = max v0 v1
  ret v3
@run -1 0 -> 0
@run 1 -1 -> 1
@run 1 2 -> 2
@run 2 1 -> 2
@run 0x7f 0x80 -> 0x80
@run 0x7fff 0x8000 -> 0x8000
@run 0x7fffffff 0x80000000 -> 0x7fffffff

---

# %umin_max_i32 (result 1)
fn main v0:i32 v1:i32 -> i32
  t0 = const -2147483648
  t1 = xor v0 t0
  t2 = xor v1 t0
  t3 = min t1 t2
  v2 = xor t3 t0
  t4 = const -2147483648
  t5 = xor v0 t4
  t6 = xor v1 t4
  t7 = max t5 t6
  v3 = xor t7 t4
  ret v2
@run 1 2 -> 1
@run 2 1 -> 1
@run 0x7fff 0x8000 -> 0x7fff
@run 0x7fffffff 0x80000000 -> 0x7fffffff

