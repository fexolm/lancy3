# %umin_max_i32 (result 2)
fn main v0:i32 v1:i32 -> i32
  t0 = const -2147483648
  t1 = xor v0 t0
  t2 = xor v1 t0
  t3 = min t1 t2
  v2 = xor t3 t0
  t4 = const -2147483648
  t5 = xor v0 t4
  t6 = xor v1 t4
  t7 = max t5 t6
  v3 = xor t7 t4
  ret v3
@run 1 2 -> 2
@run 2 1 -> 2
@run 0x7fff 0x8000 -> 0x8000
@run 0x7fffffff 0x80000000 -> 0x80000000
