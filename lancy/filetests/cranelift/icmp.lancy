# %overflow_rhs_const
fn main v0:i32 -> i32
  v1 = const -64
  t0 = ge v0 v1
  t1 = const 1
  v2 = and t0 t1
  ret v2
@run 49 -> 1
@run -65 -> 0

---

# %ugt_sub_swap
fn main v0:i32 v1:i32 -> i32
  v2 = sub v0 v1
  t0 = const -2147483648
  t1 = xor v2 t0
  t2 = xor v0 t0
  t3 = gt t1 t2
  t4 = const 1
  v3 = and t3 t4
  ret v3
@run 1 -49 -> 1
@run 1 2 -> 1
@run 2 1 -> 0

---

# %ule_sub_swap
fn main v0:i32 v1:i32 -> i32
  v2 = sub v0 v1
  t0 = const -2147483648
  t1 = xor v2 t0
  t2 = xor v0 t0
  t3 = le t1 t2
  t4 = const 1
  v3 = and t3 t4
  ret v3
@run 1 -88 -> 0
@run 1 2 -> 0
@run 2 1 -> 1

---

# %test_bxor_slt_sgt
fn main v0:i32 v1:i32 -> i32
  t0 = lt v0 v1
  t1 = const 1
  v2 = and t0 t1
  t2 = gt v0 v1
  t3 = const 1
  v3 = and t2 t3
  v4 = xor v2 v3
  ret v4
@run 1 1 -> 0
@run 1 3 -> 1

---

# %test_bxor_ult_ugt
fn main v0:i32 v1:i32 -> i32
  t0 = const -2147483648
  t1 = xor v0 t0
  t2 = xor v1 t0
  t3 = lt t1 t2
  t4 = const 1
  v2 = and t3 t4
  t5 = const -2147483648
  t6 = xor v0 t5
  t7 = xor v1 t5
  t8 = gt t6 t7
  t9 = const 1
  v3 = and t8 t9
  v4 = xor v2 v3
  ret v4
@run 1 1 -> 0
@run 1 3 -> 1

---

# %test_slt_sgt
fn main v0:i32 v1:i32 -> i32
  t0 = lt v0 v1
  t1 = const 1
  v2 = and t0 t1
  t2 = gt v0 v1
  t3 = const 1
  v3 = and t2 t3
  v4 = and v2 v3
  ret v4
@run 42 24 -> 0

---

# %test_ult_ugt
fn main v0:i32 v1:i32 -> i32
  t0 = const -2147483648
  t1 = xor v0 t0
  t2 = xor v1 t0
  t3 = lt t1 t2
  t4 = const 1
  v2 = and t3 t4
  t5 = const -2147483648
  t6 = xor v0 t5
  t7 = xor v1 t5
  t8 = gt t6 t7
  t9 = const 1
  v3 = and t8 t9
  v4 = and v2 v3
  ret v4
@run 42 24 -> 0

---

# %test_slt_ugt_neg_const_y
fn main v0:i32 -> i32
  v1 = const -10
  t0 = lt v0 v1
  t1 = const 1
  v2 = and t0 t1
  t2 = const -2147483648
  t3 = xor v0 t2
  t4 = xor v1 t2
  t5 = gt t3 t4
  t6 = const 1
  v3 = and t5 t6
  v4 = and v2 v3
  ret v4
@run 42 -> 0

---

# %test_slt_ugt_pos_const_x
fn main v0:i32 -> i32
  v1 = const 10
  t0 = lt v1 v0
  t1 = const 1
  v2 = and t0 t1
  t2 = const -2147483648
  t3 = xor v1 t2
  t4 = xor v0 t2
  t5 = gt t3 t4
  t6 = const 1
  v3 = and t5 t6
  v4 = and v2 v3
  ret v4
@run 42 -> 0

---

# %test_ult_sgt_pos_const_y
fn main v0:i32 -> i32
  v1 = const 10
  t0 = const -2147483648
  t1 = xor v0 t0
  t2 = xor v1 t0
  t3 = lt t1 t2
  t4 = const 1
  v2 = and t3 t4
  t5 = gt v0 v1
  t6 = const 1
  v3 = and t5 t6
  v4 = and v2 v3
  ret v4
@run 42 -> 0

---

# %test_ult_sgt_neg_const_x
fn main v0:i32 -> i32
  v1 = const -10
  t0 = const -2147483648
  t1 = xor v1 t0
  t2 = xor v0 t0
  t3 = lt t1 t2
  t4 = const 1
  v2 = and t3 t4
  t5 = gt v1 v0
  t6 = const 1
  v3 = and t5 t6
  v4 = and v2 v3
  ret v4
@run 42 -> 0

---

# %test_ult_ne_minus_one
fn main v0:i32 v1:i32 -> i32
  t0 = const -2147483648
  t1 = xor v0 t0
  t2 = xor v1 t0
  t3 = lt t1 t2
  t4 = const 1
  v2 = and t3 t4
  v3 = const -1
  t5 = ne v0 v3
  t6 = const 1
  v4 = and t5 t6
  v5 = and v2 v4
  ret v5
@run 3 5 -> 1
@run -1 1 -> 0
