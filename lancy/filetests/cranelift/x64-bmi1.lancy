# %blsi32
fn main v0:i32 -> i32
  t0 = const 0
  v1 = sub t0 v0
  v2 = and v0 v1
  ret v2
@run 0 -> 0
@run 1 -> 1
@run 0x80 -> 0x80
@run 0xf80 -> 0x80
@run 0xffff0000 -> 0x10000

---

# %blsr32
fn main v0:i32 -> i32
  v1 = const 1
  v2 = sub v0 v1
  v3 = and v0 v2
  ret v3
@run 0 -> 0
@run 1 -> 0
@run 0x3 -> 0x2
@run 0xff -> 0xfe
@run 0x10001000 -> 0x10000000

---

# %blsmsk32
fn main v0:i32 -> i32
  v1 = const 1
  v2 = sub v0 v1
  v3 = xor v0 v2
  ret v3
@run 0 -> -1
@run 1 -> 1
@run 0x80 -> 0xff
@run 0x8080 -> 0xff
@run 0xffffffff -> 1
