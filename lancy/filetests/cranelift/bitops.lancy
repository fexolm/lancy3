  v2 = and v0 v1
  t0 = const -2147483648
  t1 = xor v2 t0
  t2 = xor v0 t0
  t3 = le t1 t2
  t4 = const 1
  v3 = and t3 t4
  ret v3
@run 0 0 -> 1
@run 1 0 -> 1

