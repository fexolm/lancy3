  v2 = and v0 v1
  t0 = const -1
  v3 = xor v1 t0
  v4 = and v0 v3
  v5 = or v2 v4
  ret v5
@run 0 0 -> 0
@run 1 0 -> 1
@run 0xf0 0x0f -> 0xf0

