# %bnot_band
fn main -> i32
  v1 = const 0
  v2 = const 1
  t0 = const -1
  v3 = xor v1 t0
  v4 = and v3 v2
  ret v4
@run -> 1

---

# %a64_extr_i32_12
fn main v0:i32 v1:i32 -> i32
  t0 = const 12
  t1 = shr v0 t0
  t2 = const 1048575
  v2 = and t1 t2
  t3 = const 20
  v3 = shl v1 t3
  v4 = or v2 v3
  ret v4
@run 0x1234_5678 0x1234_5678 -> 0x678_1234_5
@run 0x1234_5678 0x9abc_def0 -> 0xef0_1234_5

---

# %a64_extr_i32_12_swap
fn main v0:i32 v1:i32 -> i32
  t0 = const 20
  v2 = shl v0 t0
  t1 = const 12
  t2 = shr v1 t1
  t3 = const 1048575
  v3 = and t2 t3
  v4 = or v2 v3
  ret v4
@run 0x1234_5678 0x1234_5678 -> 0x678_1234_5
@run 0x1234_5678 0x9abc_def0 -> 0x678_9abc_d

---

# %a64_extr_i32_28
fn main v0:i32 v1:i32 -> i32
  t0 = const 4
  t1 = shr v0 t0
  t2 = const 268435455
  v2 = and t1 t2
  t3 = const 28
  v3 = shl v1 t3
  v4 = or v2 v3
  ret v4
@run 0x1234_5678 0x1234_5678 -> 0x8_1234_567
@run 0x1234_5678 0x9abc_def0 -> 0x0_1234_567

---

# %a64_extr_i32_28_swap
fn main v0:i32 v1:i32 -> i32
  t0 = const 4
  v2 = shl v0 t0
  t1 = const 28
  t2 = shr v1 t1
  t3 = const 15
  v3 = and t2 t3
  v4 = or v2 v3
  ret v4
@run 0x1234_5678 0x1234_5678 -> 0x234_5678_1
@run 0x1234_5678 0x9abc_def0 -> 0x234_5678_9

---

# %test_bxor_bor_band_i64 (low 32 bits)
fn main v0:i32 v1:i32 -> i32
  v2 = or v0 v1
  v3 = and v0 v1
  v4 = xor v2 v3
  ret v4
@run 0 0 -> 0
@run 0 1 -> 1
@run 1 0 -> 1
@run 1 1 -> 0
@run 7879 7879 -> 0

---

# %test_and_and1
fn main v0:i32 v1:i32 -> i32
  v2 = and v0 v1
  v3 = and v2 v0
  ret v3
@run 4 3 -> 0

---

# %test_and_and2
fn main v0:i32 v1:i32 -> i32
  v2 = and v0 v1
  v3 = and v0 v2
  ret v3
@run 4 3 -> 0

---

# %test_and_and3
fn main v0:i32 v1:i32 -> i32
  v2 = and v1 v0
  v3 = and v0 v2
  ret v3
@run 4 3 -> 0

---

# %test_and_and4
fn main v0:i32 v1:i32 -> i32
  v2 = and v1 v0
  v3 = and v2 v0
  ret v3
@run 4 3 -> 0

---

# %fold_and_xor_not
fn main v0:i32 v1:i32 -> i32
  t0 = const -1
  v2 = xor v1 t0
  v3 = xor v0 v2
  v4 = and v3 v0
  ret v4
@run 4 5 -> 4

---

# %fold_add_or_and3
fn main v0:i32 v1:i32 -> i32
  v2 = or v0 v1
  v3 = and v0 v1
  v4 = add v2 v3
  ret v4
@run 4 5 -> 9

---

# %fold_add_and_xor4 (low 32 bits)
fn main v0:i32 v1:i32 -> i32
  v2 = and v0 v1
  v3 = xor v0 v1
  v4 = add v2 v3
  ret v4
@run 1 2 -> 3

---

# %fold_or_and14 (low 32 bits)
fn main v0:i32 v1:i32 -> i32
  v2 = and v0 v1
  v3 = or v2 v0
  ret v3
@run 0xffff0000 0x0000ffff -> 0xffff0000

---

# %fold_xor_xor15 (low 32 bits)
fn main v0:i32 v1:i32 -> i32
  v2 = xor v0 v1
  v3 = xor v1 v2
  ret v3
@run 0xdead0000 0x0000beef -> 0xdead0000

---

# %fold_or_and_not
fn main v0:i32 v1:i32 -> i32
  v2 = and v0 v1
  t0 = const -1
  v3 = xor v0 t0
  v4 = or v2 v3
  ret v4
@run 0 0 -> 0xffffffff

---

# %test_bxor_band_band
fn main v0:i32 v1:i32 v2:i32 -> i32
  v3 = and v0 v1
  v4 = and v0 v2
  v5 = xor v3 v4
  ret v5
@run 2 1 1 -> 0

---

# %test_bor_band_bnot_bxor
fn main v0:i32 v1:i32 -> i32
  v2 = and v0 v1
  v3 = xor v0 v1
  t0 = const -1
  v4 = xor v3 t0
  v5 = or v2 v4
  ret v5
@run 0 0 -> 0xffffffff
@run 1 1 -> 0xffffffff
@run 0 1 -> 0xfffffffe
@run 2 1 -> 0xfffffffc

---

# %test_iadd_bor_ineg
fn main v0:i32 v1:i32 -> i32
  v2 = or v0 v1
  t0 = const 0
  v3 = sub t0 v1
  v4 = add v2 v3
  ret v4
@run 0 0 -> 0
@run 1 1 -> 0
@run 2 1 -> 2
@run 0xffffffff 0 -> -1

---

# %test_band_bor_absorb_x
fn main v0:i32 v1:i32 -> i32
  v2 = or v0 v1
  v3 = and v2 v0
  ret v3
@run 0 0 -> 0
@run 1 0 -> 1
@run 1 1 -> 1
@run 2 1 -> 2
@run 0xf0f0f0f0 0x0f0f0f0f -> 0xf0f0f0f0

---

# %test_band_bor_bor
fn main v0:i32 v1:i32 v2:i32 -> i32
  v3 = or v0 v2
  v4 = or v1 v2
  v5 = and v3 v4
  ret v5
@run 0 0 0 -> 0
@run 1 0 0 -> 0
@run 1 0 1 -> 1

---

# %test_bor_band_band
fn main v0:i32 v1:i32 v2:i32 -> i32
  v3 = and v0 v2
  v4 = and v1 v2
  v5 = or v3 v4
  ret v5
@run 0 0 0 -> 0
@run 1 0 0 -> 0
@run 1 0 1 -> 1
@run 2 1 1 -> 1
@run 0xf0 0x0f 0xaa -> 0xaa

---

# %test_bxor_bor_bor_bnot
fn main v0:i32 v1:i32 -> i32
  v2 = or v0 v1
  t0 = const -1
  v3 = xor v1 t0
  v4 = or v0 v3
  v5 = xor v2 v4
  ret v5
@run 0 0 -> 0xffffffff
@run 1 0 -> 0xfffffffe
@run 1 1 -> 0xfffffffe
@run 0x12345678 0x9abcdef0 -> 0xedcba987
@run 0xffffffff 0 -> 0

---

# %test_band_bnot_bnot
fn main v0:i32 v1:i32 -> i32
  t0 = const -1
  v2 = xor v0 t0
  t1 = const -1
  v3 = xor v1 t1
  v4 = and v2 v3
  ret v4
@run 0 0 -> 0xffffffff
@run 1 0 -> 0xfffffffe
@run 1 1 -> 0xfffffffe

---

# %test_bor_bnot_bnot
fn main v0:i32 v1:i32 -> i32
  t0 = const -1
  v2 = xor v0 t0
  t1 = const -1
  v3 = xor v1 t1
  v4 = or v2 v3
  ret v4
@run 0 0 -> 0xffffffff
@run 1 0 -> 0xffffffff
@run 1 1 -> 0xfffffffe

---

# %test_bor_bxor_bxor_x
fn main v0:i32 v1:i32 v2:i32 -> i32
  v3 = xor v0 v1
  v4 = xor v3 v2
  v5 = or v4 v0
  ret v5
@run 0 0 0 -> 0
@run 1 0 0 -> 1
@run 1 1 0 -> 1

---

# %simplify_icmp_eq_bxor_shared_rhs
fn main v0:i32 v1:i32 v2:i32 -> i32
  v3 = xor v0 v2
  v4 = xor v1 v2
  t0 = eq v3 v4
  t1 = const 1
  v5 = and t0 t1
  ret v5
@run 0 0 0 -> 1
@run 1 1 7 -> 1
@run 1 2 7 -> 0

---

# %test_bor_bnot_bor_absorb
fn main v0:i32 v1:i32 -> i32
  v2 = or v0 v1
  t0 = const -1
  v3 = xor v2 t0
  v4 = or v1 v3
  ret v4
@run 0 0 -> 0xffffffff
@run 1 0 -> 0xfffffffe

---

# %test_band_bnot_band_absorb
fn main v0:i32 v1:i32 -> i32
  v2 = and v0 v1
  t0 = const -1
  v3 = xor v2 t0
  v4 = and v1 v3
  ret v4
@run 0 0 -> 0
@run 1 0 -> 0
@run 0 1 -> 1

---

# %test_bxor_bnot_bor
fn main v0:i32 v1:i32 -> i32
  t0 = const -1
  v2 = xor v0 t0
  v3 = or v0 v1
  v4 = xor v2 v3
  ret v4
@run 0 0 -> 0xffffffff
@run 1 0 -> 0xffffffff

---

# %test_bor_slt_sgt
fn main v0:i32 v1:i32 -> i32
  t0 = lt v0 v1
  t1 = const 1
  v2 = and t0 t1
  t2 = gt v0 v1
  t3 = const 1
  v3 = and t2 t3
  v4 = or v2 v3
  ret v4
@run 1 1 -> 0
@run 1 3 -> 1
@run 3 1 -> 1

---

# %test_bor_ult_ugt
fn main v0:i32 v1:i32 -> i32
  t0 = const -2147483648
  t1 = xor v0 t0
  t2 = xor v1 t0
  t3 = lt t1 t2
  t4 = const 1
  v2 = and t3 t4
  t5 = const -2147483648
  t6 = xor v0 t5
  t7 = xor v1 t5
  t8 = gt t6 t7
  t9 = const 1
  v3 = and t8 t9
  v4 = or v2 v3
  ret v4
@run 1 1 -> 0
@run 1 3 -> 1
@run 3 1 -> 1

---

# %test_bnot_band_bnot
fn main v0:i32 v1:i32 -> i32
  t0 = const -1
  v2 = xor v0 t0
  v3 = and v2 v1
  t1 = const -1
  v4 = xor v3 t1
  ret v4
@run 0 0 -> 0xffffffff
@run 1 0 -> 0xffffffff
@run 0 1 -> 0xfffffffe

---

# %test_bnot_bor_bnot
fn main v0:i32 v1:i32 -> i32
  t0 = const -1
  v2 = xor v0 t0
  v3 = or v2 v1
  t1 = const -1
  v4 = xor v3 t1
  ret v4
@run 0 0 -> 0
@run 1 0 -> 1
@run 0 1 -> 0

---

# %test_bor_bxor_bxor_chain
fn main v0:i32 v1:i32 v2:i32 -> i32
  v3 = xor v0 v1
  v4 = xor v3 v2
  v5 = or v3 v4
  ret v5
@run 0 0 0 -> 0
@run 1 0 0 -> 1
@run 1 1 0 -> 0

---

# %test_bor_bxor_self
fn main v0:i32 v1:i32 -> i32
  v2 = xor v0 v1
  v3 = or v0 v2
  ret v3
@run 0 0 -> 0
@run 1 0 -> 1
@run 1 1 -> 1
@run 0xf0 0x0f -> 0xff

---

# %test_bnot_iadd_bnot_to_isub_rt
fn main v0:i32 v1:i32 -> i32
  t0 = const -1
  v2 = xor v0 t0
  v3 = add v2 v1
  t1 = const -1
  v4 = xor v3 t1
  ret v4
@run 0 0 -> 0
@run 4 5 -> -1
@run 0x12345678 0x11111111 -> 0x01234567

---

# %test_bor_bxor_bor
fn main v0:i32 v1:i32 v2:i32 -> i32
  v3 = xor v0 v2
  v4 = or v1 v0
  v5 = or v3 v4
  ret v5
@run 0 0 0 -> 0
@run 1 0 0 -> 1
@run 0xf0 0x0f 0xaa -> 0xff

---

# %test_bxor_bor_bxor
fn main v0:i32 v1:i32 -> i32
  v2 = or v0 v1
  v3 = xor v0 v1
  v4 = xor v2 v3
  ret v4
@run 0 0 -> 0
@run 1 0 -> 0
@run 0x12345678 0x9abcdef0 -> 0x12345670

---

# %test_bor_band_bxor
fn main v0:i32 v1:i32 v2:i32 -> i32
  v3 = xor v0 v1
  v4 = and v3 v2
  v5 = or v4 v0
  ret v5
@run 0 0 0 -> 0
@run 1 0 0 -> 1
@run 1 1 1 -> 1
@run 2 1 1 -> 3
@run 0xf0 0x0f 0xaa -> 0xfa

---

# %test_bor_bor_bxor
fn main v0:i32 v1:i32 v2:i32 -> i32
  v3 = or v0 v1
  v4 = xor v0 v2
  v5 = or v3 v4
  ret v5
@run 0 0 0 -> 0
@run 1 0 0 -> 1
@run 1 1 0 -> 1
@run 1 0 1 -> 1
@run 0xf0 0x0f 0xaa -> 0xff

