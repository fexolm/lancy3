# %test_uge_x_band
fn main v0:i32 v1:i32 -> i32
  v2 = and v0 v1
  t0 = const -2147483648
  t1 = xor v0 t0
  t2 = xor v2 t0
  t3 = ge t1 t2
  t4 = const 1
  v3 = and t3 t4
  ret v3
@run 0 0 -> 1
@run 1 0 -> 1

---

# %test_ule_band_x
