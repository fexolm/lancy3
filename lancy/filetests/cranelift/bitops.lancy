# %test_aarch64_extr
fn main v0:i32 v1:i32 -> i32
  t0 = const 32
  v2 = shl v0 t0
  t1 = const 0
  t2 = shr v1 t1
  t3 = const -1
  v3 = and t2 t3
  v4 = or v2 v3
  ret v4
@run 1 0 -> 1
@run 0 1 -> 1

