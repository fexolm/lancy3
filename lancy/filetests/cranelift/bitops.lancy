# %simplify_icmp_ne_bxor_shared_rhs
fn main v0:i32 v1:i32 v2:i32 -> i32
  v3 = xor v0 v2
  v4 = xor v1 v2
  t0 = ne v3 v4
  t1 = const 1
  v5 = and t0 t1
  ret v5
@run 0 0 0 -> 0
@run 1 1 7 -> 0
@run 0x12345678 0x87654321 0x9abcdef0 -> 1

