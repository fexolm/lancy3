# %test_eq_band_bnot_fullmask
fn main v0:i32 v1:i32 -> i32
  t0 = const -1
  v2 = xor v1 t0
  v3 = and v0 v2
  t1 = eq v3 v2
  t2 = const 1
  v4 = and t1 t2
  ret v4
@run 0 0 -> 0
@run -1 0 -> 1

