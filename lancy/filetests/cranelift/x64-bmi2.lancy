# %bzhi32
fn main v0:i32 v1:i32 -> i32
  v2 = const 1
  v3 = shl v2 v1
  v4 = sub v3 v2
  v5 = and v0 v4
  ret v5
@run 0 0 -> 0
@run 0 1 -> 0
@run 1 0 -> 0
@run 1 32 -> 0
@run 1 8 -> 1
@run 0xff 4 -> 0xf
@run 0xff 1 -> 1
@run 0xff 0 -> 0
@run 0xff 0xff0001 -> 1
@run 0x01234567 16 -> 0x4567
@run 0x01234567 32 -> 0
@run 0x01234567 28 -> 0x1234567
@run 0x01234567 24 -> 0x234567
@run -1 24 -> 0xffffff
