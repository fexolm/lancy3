# Adapted from Wasmtime v45.0.3, runtests/call.clif (%call_i64).
# SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
# Use Lancy's outlined internal ABI with a single i32 parameter and result.
@policy never
fn callee(x:i32) -> i32
  ten = const 10
  result = add x ten
  ret result

fn main(x:i32) -> i32
  result = call callee(x)
  ret result

@inline check: call f0
@opt check: call f0
@isel check: store_arg 0
@isel nextln: call f0
@alloc check: call f0
@asm check: endbr64
@asm check: jmp
@run 10 -> 20
@run 2147483647 -> -2147483639
