fn main x:i32 y:i32 -> i32
  a = cast i8 x
  b = cast i8 y
  av = simd.splat a
  bv = simd.splat b
  signed = simd.min av bv
  ax = simd.bitcast u8 av
  bx = simd.bitcast u8 bv
  unsigned = simd.max ax bx
  zero = const 0
  s = simd.extract signed zero
  u = simd.extract unsigned zero
  s32 = cast i32 s
  u32 = cast i32 u
  three = const 3
  base = mul s32 three
  result = add base u32
  ret result
