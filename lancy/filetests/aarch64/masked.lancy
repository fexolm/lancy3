fn main(data:ptr flag:i32) -> i32
  z = const 0
  one = const 1
  positive = splat one
  mask = insert positive z flag
  fallback = const 79
  pass = splat fallback
  got = maskedload data - mask pass
  next = const 99
  stores = splat next
  maskedstore data - mask stores
  first = extract got z
  second = extract got one
  r = sub first second
  ret r
@aarch64 sve has z.ld1w
@aarch64 sve has z.st1w
@aarch64 sve2 has z.ld1w
@aarch64 sve2 has z.st1w
