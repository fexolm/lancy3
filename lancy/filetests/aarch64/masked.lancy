fn main(flag1:i32 flag3:i32) -> i32
  zero = const 0
  one = const 1
  two = const 2
  three = const 3
  four = const 4
  eight = const 8
  twelve = const 12
  eleven = const 11
  len = lanes i32
  last = sub len one
  ramp = iota i32
  start = splat eleven
  values = add ramp start
  positive = splat one
  mask1 = insert positive one flag1
  mask = insert mask1 three flag3
  compressed = compress values mask
  a = extract compressed zero
  b = extract compressed one
  c = extract compressed two
  d = extract compressed last
  b4 = shl b four
  c8 = shl c eight
  d12 = shl d twelve
  lo = add a b4
  hi = add c8 d12
  r = add lo hi
  ret r
@aarch64 neon lacks z.compact.s
@aarch64 sve has z.compact.s
@aarch64 sve2 has z.compact.s
