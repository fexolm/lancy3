fn main(data:ptr flag:i32) -> i32
  z = const 0
  one = const 1
  n = lanes u8
  last = sub n one
  base = offset data one 1
  invalid = literal i8 0x80
  left = literal i8 0xff
  initial = splat invalid
  i0 = insert initial z left
  indices = insert i0 last left
  low = literal u8 0x1
  active = literal u8 0x81
  last_mask = cast u8 flag
  off = splat low
  m0 = insert off z active
  flags = insert m0 last last_mask
  a = literal u8 0x31
  b = literal u8 0x95
  data_a = splat a
  values = insert data_a last b
  maskedstore base indices flags values
  ret z
