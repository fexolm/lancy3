fn main data:ptr flag:i32 -> i32
  z = const 0
  one = const 1
  positive = simd.splat one
  mask = simd.insert positive z flag
  fallback = const 79
  pass = simd.splat fallback
  got = simd.maskedload data - mask pass
  next = const 99
  stores = simd.splat next
  simd.maskedstore data - mask stores
  first = simd.extract got z
  second = simd.extract got one
  r = sub first second
  ret r
@aarch64 sve has z.ld1w
@aarch64 sve has z.st1w
@aarch64 sve2 has z.ld1w
@aarch64 sve2 has z.st1w
@run 0x80000000 -> -37 | 2a 00 00 00 0b 00 00 00 | 63 00 00 00 0b 00 00 00
@run 1 -> 0 | 2a 00 00 00 0b 00 00 00 | 2a 00 00 00 0b 00 00 00
---
fn main flag1:i32 flag3:i32 -> i32
  zero = const 0
  one = const 1
  two = const 2
  three = const 3
  four = const 4
  eight = const 8
  twelve = const 12
  eleven = const 11
  len = simd.lanes i32
  last = sub len one
  ramp = simd.iota i32
  start = simd.splat eleven
  values = simd.add ramp start
  positive = simd.splat one
  mask1 = simd.insert positive one flag1
  mask = simd.insert mask1 three flag3
  compressed = simd.compress values mask
  a = simd.extract compressed zero
  b = simd.extract compressed one
  c = simd.extract compressed two
  d = simd.extract compressed last
  b4 = shl b four
  c8 = shl c eight
  d12 = shl d twelve
  lo = add a b4
  hi = add c8 d12
  r = add lo hi
  ret r
@aarch64 neon lacks z.compact.s
@aarch64 sve has z.compact.s
@aarch64 sve2 has z.compact.s
@run 0x80000000 0x80000000 -> 236
@run 0x80000001 0x80000000 -> 236
@run 1 0x80000000 -> 14
@run 1 1 -> 0
---
fn main data:ptr flag:i32 -> i32
  z = const 0
  one = const 1
  n = simd.lanes u16
  last = sub n one
  base = offset data one 2
  invalid = literal i16 0x8000
  right = literal i16 0x1
  left = literal i16 0xffff
  ones = literal u16 0x1
  active = literal u16 0x8001
  last_mask = cast u16 flag
  fill = simd.splat invalid
  i0 = simd.insert fill z right
  indices = simd.insert i0 last left
  off = simd.splat ones
  m0 = simd.insert off z active
  flags = simd.insert m0 last last_mask
  alternate = literal u16 0x49
  pass = simd.splat alternate
  got = simd.maskedload base indices flags pass
  a = simd.extract got z
  b = simd.extract got one
  c = simd.extract got last
  ai = cast i32 a
  bi = cast i32 b
  ci = cast i32 c
  ab = add ai bi
  r = add ab ci
  ret r
@aarch64 sve has z.ld1h.gather.s
@aarch64 sve2 has z.ld1h.gather.s
@aarch64 all lacks blr
@run 0x8001 -> 207 | 21 00 43 00 65 00 | 21 00 43 00 65 00
@run 1 -> 247 | 21 00 43 00 65 00 | 21 00 43 00 65 00
---
fn main data:ptr flag:i32 -> i32
  z = const 0
  one = const 1
  n = simd.lanes u8
  last = sub n one
  base = offset data one 1
  invalid = literal i8 0x80
  left = literal i8 0xff
  initial = simd.splat invalid
  i0 = simd.insert initial z left
  indices = simd.insert i0 last left
  low = literal u8 0x1
  active = literal u8 0x81
  last_mask = cast u8 flag
  off = simd.splat low
  m0 = simd.insert off z active
  flags = simd.insert m0 last last_mask
  a = literal u8 0x31
  b = literal u8 0x95
  data_a = simd.splat a
  values = simd.insert data_a last b
  simd.maskedstore base indices flags values
  ret z
@aarch64 sve has z.st1b.scatter.s
@aarch64 sve2 has z.st1b.scatter.s
@aarch64 all lacks blr
@run 0x81 -> 0 | 00 43 65 | 95 43 65
@run 1 -> 0 | 00 43 65 | 31 43 65
