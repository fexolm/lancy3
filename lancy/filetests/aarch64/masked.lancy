fn main(data:ptr flag:i32) -> i32
  z = const 0
  one = const 1
  n = lanes u16
  last = sub n one
  base = offset data one 2
  invalid = literal i16 0x8000
  right = literal i16 0x1
  left = literal i16 0xffff
  ones = literal u16 0x1
  active = literal u16 0x8001
  last_mask = cast u16 flag
  fill = splat invalid
  i0 = insert fill z right
  indices = insert i0 last left
  off = splat ones
  m0 = insert off z active
  flags = insert m0 last last_mask
  alternate = literal u16 0x49
  pass = splat alternate
  got = maskedload base indices flags pass
  a = extract got z
  b = extract got one
  c = extract got last
  ai = cast i32 a
  bi = cast i32 b
  ci = cast i32 c
  ab = add ai bi
  r = add ab ci
  ret r
