---
fn main x:i32 -> i32
  zero = const 0
  one = const 1
  n = simd.lanes f64
  end = sub n one
  two = const 2
  final = mul n two
  last = sub final one
  half_low = literal f64 0x3ff0000010000000
  half_high = literal f64 0x3ff0000030000000
  a = simd.splat half_low
  b = simd.splat half_high
  raw = bitcast f32 x
  singles = simd.splat raw
  extension = simd.widenhi f64 singles
  result = simd.narrow f32 a b
  low = simd.extract result end
  high = simd.extract result last
  wide = simd.extract extension zero
  round_trip = cast f32 wide
  low_bits = bitcast i32 low
  high_bits = bitcast i32 high
  restored = bitcast i32 round_trip
  want_lo = const 0x3f800000
  want_hi = const 0x3f800002
  lo_error = xor low_bits want_lo
  hi_error = xor high_bits want_hi
  errors = or hi_error lo_error
  ext_error = xor restored x
  r = or errors ext_error
  ret r
