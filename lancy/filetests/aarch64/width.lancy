---
fn main x:i32 -> i32
  s = cast i64 x
  a = simd.splat s
  hi = simd.widenhi i128 a
  zero = const 0
  item = simd.extract hi zero
  want = cast i128 x
  extension_ok = eq item want
  b = simd.narrow i64 hi hi
  first = simd.extract b zero
  r = cast i32 first
  both = and extension_ok r
  ret both
