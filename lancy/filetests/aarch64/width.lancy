fn main raw:i32 -> i32
  bits = cast u16 raw
  value = bitcast bf16 bits
  a = simd.splat value
  hi = simd.widenhi f32 a
  zero = const 0
  f = simd.extract hi zero
  r = bitcast i32 f
  ret r
