fn main x:i32 -> i32
  zero = const 0
  one = const 1
  n = simd.lanes i16
  half = shr n one
  start = cast i16 x
  base = simd.splat start
  lanes = simd.iota i16
  values = simd.add lanes base
  low = simd.widenlo i32 values
  high = simd.widenhi i32 values
  swapped = simd.narrow i16 high low
  mid = cast i16 half
  offset = simd.splat mid
  indices = simd.xor lanes offset
  expected = simd.add indices base
  diffs = simd.ne swapped expected
  bad_order = simd.any diffs
  lo_first = simd.extract low zero
  hi_first = simd.extract high zero
  source_first = simd.extract values half
  hi_expected = cast i32 source_first
  lo_expected = cast i32 start
  hi_error = xor hi_first hi_expected
  lo_error = xor lo_first lo_expected
  bad_values = or hi_error lo_error
  result = or bad_order bad_values
  ret result
