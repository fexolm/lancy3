fn main(left:i32 right:i32) -> i32
  a = bitcast f32 left
  b = bitcast f32 right
  av = splat a
  bv = splat b
  mask = unordered av bv
  one = const 1
  n = lanes i32
  last = sub n one
  out = extract mask last
  ret out
