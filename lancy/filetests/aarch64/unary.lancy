fn main(x:i32) -> i32
  lane = bitcast f32 x
  first = literal f32 0x3f800000
  uniform = splat first
  lanes = lanes f32
  one = const 1
  last = sub lanes one
  data = insert uniform last lane
  rounded = round data
  result = extract rounded last
  r = bitcast i32 result
  ret r
@aarch64-isel check: unary 
