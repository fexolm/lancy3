fn main(x:i32) -> i32
  a = cast u8 x
  lz = leadingzeros a
  tz = trailingzeros a
  pop = popcnt a
  l = cast i32 lz
  t = cast i32 tz
  p = cast i32 pop
  hundred = const 100
  ten = const 10
  lh = mul l hundred
  tt = mul t ten
  sum = add lh tt
  r = add sum p
  ret r
