@aarch64 all lacks blr
@run 0x4580 0x4200 -> 0x4100
@run 0xc580 0xc200 -> 0xc100
@run 0xc600 0x4200 -> 0x8000
@run 0x8000 0x4200 -> 0x8000
@run 0x0001 0xfc00 -> 1
@run 0x8001 0x3c00 -> 0x8001
@run 0x0401 3 -> 2
@run 0x83ff 7 -> 0x8001
@run 0x0400 0x03ff -> 1
@run 0x7bff 11 -> 6
---
fn main x:i32 y:i32 -> i32
  xb = cast u16 x
  yb = cast u16 y
  a = bitcast bf16 xb
  b = bitcast bf16 yb
  av = simd.splat a
  bv = simd.splat b
  c = simd.rem av bv
  n = simd.lanes bf16
  one = const 1
  last = sub n one
  v = simd.extract c last
  bits = bitcast u16 v
  r = cast i32 bits
  ret r
