fn main x:i32 y:i32 -> i32
  xb = cast u16 x
  yb = cast u16 y
  a = bitcast f16 xb
  b = bitcast f16 yb
  c = rem a b
  bits = bitcast u16 c
  r = cast i32 bits
  ret r
