fn main m:i32 a:i32 b:i32 -> i32
  mask = cast u8 m
  yes = cast u8 a
  no = cast u8 b
  flags = simd.splat mask
  y = simd.splat yes
  n = simd.splat no
  selected = simd.select flags y n
  zero = const 0
  one = const 1
  lanes = simd.lanes u8
  last = sub lanes one
  value = simd.extract selected last
  live = simd.extract y zero
  out = cast i32 value
  original = cast i32 live
  eight = const 8
  kept = shl original eight
  result = or kept out
  ret result
