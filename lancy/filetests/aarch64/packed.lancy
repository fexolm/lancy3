fn main(x:i32) -> i32
  lanes = lanes u8
  byte_lanes = cast u8 lanes
  a = iota u8
  b = splat byte_lanes
  diff = sub a b
  factor = cast u8 x
  factors = splat factor
  product = mul diff factors
  one = const 1
  last = sub lanes one
  value = extract product last
  result = cast i32 value
  ret result
