fn main x:i32 y:i32 -> i32
  ax = cast u8 x
  ay = cast u8 y
  a = simd.iota u8
  b = simd.splat ax
  c = simd.splat ay
  inner = simd.xor a b
  result = simd.xor c inner
  one = const 1
  lane = simd.extract result one
  r = cast i32 lane
  ret r
