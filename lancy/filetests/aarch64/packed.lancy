fn main x:i32 y:i32 -> i32
  ax = cast u8 x
  ay = cast u8 y
  a = simd.iota u8
  b = simd.splat ax
  c = simd.splat ay
  inner = simd.xor a b
  result = simd.xor inner c
  one = const 1
  p = simd.extract inner one
  q = simd.extract result one
  pp = cast i32 p
  qq = cast i32 q
  r = add pp qq
  ret r
