fn main(x:i32 y:i32) -> i32
  z = const 0
  a = splat x
  b = splat y
  signed = lt a b
  s = extract signed z
  xu = bitcast u32 x
  yu = bitcast u32 y
  ua = splat xu
  ub = splat yu
  unsigned = lt ua ub
  um = extract unsigned z
  u = bitcast i32 um
  s2 = add s s
  r = add s2 u
  ret r
