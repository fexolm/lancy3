fn main(x:i32 y:i32) -> i32
  z = const 0
  xf = bitcast f32 x
  yf = bitcast f32 y
  a = splat xf
  b = splat yf
  eq = eq a b
  ne = ne a b
  lt = lt a b
  e = extract eq z
  n = extract ne z
  l = extract lt z
  two = const 2
  four = const 4
  n2 = mul n two
  l4 = mul l four
  partial = add e n2
  r = add partial l4
  ret r
