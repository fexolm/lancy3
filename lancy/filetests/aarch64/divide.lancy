fn main(x:i32 y:i32) -> i32
  a = cast i8 x
  b = cast i8 y
  all_a = splat a
  all_b = splat b
  value = rem all_a all_b
  n = lanes i8
  one = const 1
  last = sub n one
  lane = extract value last
  result = cast i32 lane
  ret result
@aarch64-isel check: vector.
@aarch64 all lacks blr
@run -7 3 -> -1
@run 7 -3 -> 1
@run -128 -1 -> !overflow
@run -128 2 -> 0
@run 1 0 -> !zero
---
fn main(x:i32) -> i32
  zero = const 0
  one = const 1
  a = splat one
  b = splat x
  unused = div a b
  ret zero
@aarch64-isel check: vector.
@aarch64 all lacks blr
@run 0 -> !zero
@run 1 -> 0
