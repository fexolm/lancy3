fn main p:ptr first:i32 second:i32 -> i32
  one = const 1
  zero = const 0
  two = const 2
  before = const 77
  after = const 99
  min = const 0x80000000
  store p before
  dividend = simd.splat min
  good = simd.splat two
  rhs0 = simd.insert good zero first
  rhs = simd.insert rhs0 one second
  value = simd.div dividend rhs
  next = offset p one 4
  store next after
  result = simd.extract value zero
  ret result
