fn main(p:ptr first:i32 second:i32) -> i32
  one = const 1
  zero = const 0
  two = const 2
  before = const 77
  after = const 99
  min = const 0x80000000
  store p before
  dividend = splat min
  good = splat two
  rhs0 = insert good zero first
  rhs = insert rhs0 one second
  value = div dividend rhs
  next = offset p one 4
  store next after
  result = extract value zero
  ret result
@aarch64-isel check: vector.
@aarch64 neon has sdiv
@aarch64 sve has z.sdiv
@aarch64 sve2 has z.sdiv
@aarch64 all lacks blr
@run 0 -1 -> !zero | 00 00 00 00 00 00 00 00 | 4d 00 00 00 00 00 00 00
@run -1 0 -> !overflow | 00 00 00 00 00 00 00 00 | 4d 00 00 00 00 00 00 00
@run 2 3 -> -1073741824 | 00 00 00 00 00 00 00 00 | 4d 00 00 00 63 00 00 00
