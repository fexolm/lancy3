# Each iteration consumes a complete SIMD packet at the preceding store.
# The explicit full/short branches model Splice's checked vector stores.
# Thirty-two u16 elements form whole packets on every supported SIMD profile.
fn main p:ptr n:i32 x:i32 -> i32
  zero = const 0
  one_i32 = const 1
  one = literal u16 1
  width = simd.lanes u16
  last = sub width one_i32
  narrow = cast u16 x
  value = simd.splat narrow
  increment = simd.splat one
  jump first zero
block first i:i32
  remaining = sub n i
  full = ge remaining width
  br full first_body | bridge
block first_body
  bounds i n
  addr = offset p i 2
  next = add i width
  available = sub n i
  fits = ge available width
  br fits first_full | first_short
block first_full
  simd.store addr value
  jump first next
block first_short
  bounds n n
  jump first next
block bridge
  jump second zero
block second j:i32
  remaining_b = sub n j
  full_b = ge remaining_b width
  br full_b second_body | done
block second_body
  bounds j n
  addr_b = offset p j 2
  available_b = sub n j
  bounds last available_b
  input = simd.load u16 addr_b
  result = simd.add input increment
  next_b = add j width
  fits_b = ge available_b width
  br fits_b second_full | second_short
block second_full
  simd.store addr_b result
  jump second next_b
block second_short
  bounds n n
  jump second next_b
block done
  ret n
@source check: br
@source check: br
@opt check: br
@opt not: br
@opt not: bounds
@opt not: simd.load
@opt check: simd.store
@opt not: br
@opt not: simd.store
@opt not: bounds
@opt check: ret
