# Declared slices give disjoint regions; the raw accesses here are not
# proved to stay in either region.
fn main p:ptr p_len:i32 q:ptr q_len:i32 n:i32 -> i32
  slices 0 write4 read4
  zero = const 0
  one = const 1
  jump first zero
block first i:i32
  more = lt i n
  br more first_body | bridge
block first_body
  next = add i one
  addr = offset p i 4
  store addr next
  jump first next
block bridge
  jump second zero zero
block second j:i32 sum:i32
  more_b = lt j n
  br more_b second_body | done
block second_body
  addr_b = offset q j 4
  value = load i32 addr_b
  new_sum = add sum value
  next_b = add j one
  jump second next_b new_sum
block done
  ret sum
@opt check: br
@opt check: br

