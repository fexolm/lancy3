# A two-element stride at scale eight leaves a full u128 slot per iteration.
fn main p:ptr -> i32
  zero = const 0
  step = const 2
  bound = const 4
  high = literal u128 10000000000000000000000000000000
  increment = literal u128 2
  jump first zero
block first i:i32
  more = lt i bound
  br more first_body | bridge
block first_body
  addr = offset p i 8
  wide = cast u128 i
  value = add high wide
  store addr value
  next = add i step
  jump first next
block bridge
  jump second zero
block second j:i32
  more_b = lt j bound
  br more_b second_body | done
block second_body
  addr_b = offset p j 8
  input = load u128 addr_b
  value_b = add input increment
  store addr_b value_b
  next_b = add j step
  jump second next_b
block done
  ret bound
