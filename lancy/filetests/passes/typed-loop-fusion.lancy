# At scale four, the next u64 store changes the previous slot's high word.
fn main p:ptr n:i32 -> i32
  zero = const 0
  one = const 1
  thirty_two = literal u64 20
  jump first zero
block first i:i32
  more = lt i n
  br more first_body | bridge
block first_body
  next = add i one
  value = cast u64 next
  addr = offset p i 4
  store addr value
  jump first next
block bridge
  jump second zero zero
block second j:i32 sum:i32
  more_b = lt j n
  br more_b second_body | done
block second_body
  addr_b = offset p j 4
  input = load u64 addr_b
  high = shr input thirty_two
  word = cast i32 high
  new_sum = add sum word
  next_b = add j one
  jump second next_b new_sum
block done
  ret sum
@opt check: br
@opt check: br
@opt check: load U64
@run 2 -> 2 | aa aa aa aa aa aa aa aa aa aa aa aa | 01 00 00 00 02 00 00 00 00 00 00 00

