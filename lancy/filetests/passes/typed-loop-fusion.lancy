# Each eight-byte element is produced and consumed in the same iteration.
fn main p:ptr n:i32 -> i32
  zero = const 0
  one = const 1
  two = literal f64 4000000000000000
  jump first zero
block first i:i32
  more = lt i n
  br more first_body | bridge
block first_body
  next = add i one
  addr = offset p i 8
  value = cast f64 next
  store addr value
  jump first next
block bridge
  jump second zero
block second j:i32
  more_b = lt j n
  br more_b second_body | done
block second_body
  addr_b = offset p j 8
  input = load f64 addr_b
  product = mul input two
  store addr_b product
  next_b = add j one
  jump second next_b
block done
  ret n
@source check: br
@source check: br
@opt check: br
@opt not: br
@opt not: load
@opt check: store
@opt not: br
@opt not: store
@opt check: ret
@run 2 -> 2 | aa aa aa aa aa aa aa aa aa aa aa aa aa aa aa aa be ef | 00 00 00 00 00 00 00 40 00 00 00 00 00 00 10 40 be ef
@run 0 -> 0 | be ef | be ef

