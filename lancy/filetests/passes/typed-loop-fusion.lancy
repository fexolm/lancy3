# Both accesses fit their own stride. Different scales still create a
# dependence on a later iteration of the producer on the shared base.
fn main p:ptr n:i32 -> i32
  zero = const 0
  one = const 1
  jump first zero
block first i:i32
  more = lt i n
  br more first_body | bridge
block first_body
  next = add i one
  addr = offset p i 4
  store addr next
  jump first next
block bridge
  jump second zero zero
block second j:i32 sum:i32
  more_b = lt j n
  br more_b second_body | done
block second_body
  addr_b = offset p j 8
  input = load i32 addr_b
  new_sum = add sum input
  next_b = add j one
  jump second next_b new_sum
block done
  ret sum
@opt check: br
@opt check: br
@opt check: load I32
@run 3 -> 98 | 5a 00 00 00 5b 00 00 00 5c 00 00 00 5d 00 00 00 5e 00 00 00 | 01 00 00 00 02 00 00 00 03 00 00 00 5d 00 00 00 5e 00 00 00

