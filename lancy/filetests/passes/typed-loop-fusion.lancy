# Both access ranges fit within the declared, disjoint slices.
fn main p:ptr p_len:i32 q:ptr q_len:i32 n:i32 -> i32
  slices 0 write8 read8
  zero = const 0
  one = const 1
  p_fits = le n p_len
  br p_fits check_q | reject
block check_q
  q_fits = le n q_len
  br q_fits init | reject
block reject
  ret zero
block init
  jump first zero
block first i:i32
  more = lt i n
  br more first_body | bridge
block first_body
  next = add i one
  addr = offset p i 8
  value = cast u64 next
  store addr value
  jump first next
block bridge
  jump second zero zero
block second j:i32 sum:i32
  more_b = lt j n
  br more_b second_body | done
block second_body
  addr_b = offset q j 8
  other = load u64 addr_b
  word = cast i32 other
  new_sum = add sum word
  next_b = add j one
  jump second next_b new_sum
block done
  ret sum
