fn write out:ptr value:i32 overflow:i32 -> i32
  store out value
  check_overflow overflow
  one = const 1
  next = offset out one 4
  store next value
  ret value

fn main out:ptr value:i32 overflow:i32 -> i32
  result = call write out value overflow
  ret result
@policy never
@opt check: store
@opt nextln: check_overflow
@opt check: store
@isel check: store.I32
@isel check: check_overflow
@isel check: store.I32
@run 7 0 -> 7 | aa aa aa aa bb bb bb bb | 07 00 00 00 07 00 00 00
@run 7 -1 -> !arithmetic_overflow | aa aa aa aa bb bb bb bb | 07 00 00 00 bb bb bb bb
