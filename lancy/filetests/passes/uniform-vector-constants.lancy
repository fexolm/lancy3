# SCCP tracks uniform vectors: a splat of a constant, a same-width lane
# bitcast and an integer comparison mask fold, and the known mask selects.
fn main(x:i32) -> i32
  seven = const 7
  sevens = splat seven
  unsigned = bitcast vec.u32 sevens
  back = bitcast vec.i32 unsigned
  same = eq back sevens
  xs = splat x
  zero = const 0
  zeros = splat zero
  chosen = select same xs zeros
  result = extract chosen zero
  ret result
@source check: = eq
@opt not: = eq
@opt not: = select
@opt check: ret
@run 5 -> 5
@run -9 -> -9

---

# Counterexample: lanes of a bitcast to a narrower lane are not the uniform
# value, and a float comparison has no integer fact. Both must remain.
fn main(x:i32) -> i32
  big = const 65537
  bigs = splat big
  halves = bitcast vec.i16 bigs
  ones = splat x
  narrow = bitcast vec.i16 ones
  same = eq halves narrow
  zero = const 0
  lanes = extract same zero
  wide = cast i32 lanes
  one = literal f32 3f800000
  ones_f = splat one
  fx = cast f32 x
  xs_f = splat fx
  near = eq ones_f xs_f
  as_int = bitcast vec.i32 near
  first = extract as_int zero
  result = add wide first
  ret result
@opt check: = eq
@opt check: = eq
@run 65537 -> -1
@run 1 -> -2
@run 2 -> 0
