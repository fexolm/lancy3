# Indexed writes may reach bytes before their base.
fn main p:ptr x:i32 -> i32
  zero = const 0
  one = const 1
  minus_one = const -1
  base = offset p one 4
  before = load i32 p
  ramp = simd.iota i32
  zeros = simd.splat zero
  mask = simd.eq ramp zeros
  indices = simd.splat minus_one
  update = simd.splat x
  simd.maskedstore base indices mask update
  after = load i32 p
  r = add before after
  ret r
@opt check: load I32
@opt check: simd.maskedstore
@opt check: load I32
@run 13 -> 20 | 07 00 00 00 09 00 00 00 | 0d 00 00 00 09 00 00 00

---

# Masked reads can share a value when their inactive lanes agree.
fn main p:ptr fallback:i32 -> i32
  zero = const 0
  one = const 1
  zeros = simd.splat zero
  ramp = simd.iota i32
  mask = simd.eq ramp zeros
  inactive = simd.splat fallback
  a = simd.maskedload p - mask inactive
  b = simd.maskedload p - mask inactive
  x = simd.extract a zero
  y = simd.extract b one
  r = add x y
  ret r
@opt check: simd.maskedload
@opt not: simd.maskedload
@opt check: ret
@run 13 -> 20 | 07 00 00 00 | 07 00 00 00

---

# The passthrough is part of a masked read's value.
fn main p:ptr fallback:i32 -> i32
  zero = const 0
  one = const 1
  zeros = simd.splat zero
  ramp = simd.iota i32
  mask = simd.eq ramp zeros
  inactive = simd.splat fallback
  a = simd.maskedload p - mask zeros
  b = simd.maskedload p - mask inactive
  x = simd.extract a one
  y = simd.extract b one
  r = add x y
  ret r
@opt check: simd.maskedload
@opt check: simd.maskedload
@run 13 -> 13 | 07 00 00 00 | 07 00 00 00

---

# Identical masked scatters overwrite the same bytes, including duplicate indices.
fn main p:ptr x:i32 -> i32
  zero = const 0
  indices = simd.splat zero
  mask = simd.eq indices indices
  first = simd.iota i32
  last = simd.splat x
  simd.maskedstore p indices mask first
  simd.maskedstore p indices mask last
  ret zero
@opt check: simd.maskedstore
@opt not: simd.maskedstore
@opt check: ret
@run 13 -> 0 | 07 00 00 00 | 0d 00 00 00

---

# A different mask can leave earlier bytes untouched.
fn main p:ptr x:i32 y:i32 -> i32
  zero = const 0
  one = const 1
  zeros = simd.splat zero
  ones = simd.splat one
  ramp = simd.iota i32
  first = simd.eq ramp ones
  second = simd.eq ramp zeros
  left = simd.splat x
  right = simd.splat y
  simd.maskedstore p - first left
  simd.maskedstore p - second right
  ret zero
@opt check: simd.maskedstore
@opt check: simd.maskedstore
@run 5 7 -> 0 | aa aa aa aa bb bb bb bb | 07 00 00 00 05 00 00 00

---

# Loads on both sides of a join can reuse a common memory value.
fn main p:ptr flag:i32 -> i32
  first = load i32 p
  br flag left | right
block left
  one = const 1
  a = add first one
  jump join a
block right
  two = const 2
  b = xor first two
  jump join b
block join addend:i32
  again = load i32 p
  out = add again addend
  ret out
@opt check: load I32
@opt not: load I32
@opt check: ret
@run 1 -> 15 | 07 00 00 00 | 07 00 00 00
@run 0 -> 12 | 07 00 00 00 | 07 00 00 00

---

# An out-of-line write clobbers the previous read and may observe stores.
fn write p:ptr x:i32 -> i32
  store p x
  ret x
fn main p:ptr x:i32 -> i32
  a = load i32 p
  written = call write p x
  b = load i32 p
  out = add a b
  ret out
@policy never
@opt check: load I32
@opt check: call
@opt check: load I32
@run 13 -> 20 | 07 00 00 00 | 0d 00 00 00

---

# Full SIMD stores overwrite every byte, even across blocks.
fn main p:ptr x:i32 -> i32
  zero = const 0
  first = simd.splat x
  last = simd.splat zero
  simd.store p first
  jump overwrite
block overwrite
  simd.store p last
  ret zero
@opt check: simd.store
@opt not: simd.store
@opt check: ret
@run 7 -> 0 | 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 | 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00

