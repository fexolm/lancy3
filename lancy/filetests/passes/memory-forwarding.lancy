# Match the CFG emitted by a checked full-width Splice store.
fn main p:ptr n:i32 x:i32 -> i32
  zero = const 0
  original = simd.load u16 p
  item = cast u16 x
  updated = simd.insert original zero item
  lanes = simd.lanes u16
  full = ge n lanes
  br full whole | short
block whole
  simd.store p updated
  jump join
block short
  count = cast u16 n
  limit = simd.splat count
  indices = simd.iota u16
  active = simd.lt indices limit
  simd.maskedstore p - active updated
  bounds n n
  jump join
block join
  read = simd.load u16 p
  item_out = simd.extract read zero
  out = cast i32 item_out
  ret out
@source check: simd.store
@source check: simd.load U16
@opt check: simd.load U16
@opt check: simd.store
@opt check: simd.maskedstore
@opt check: bounds
@opt not: simd.load
@opt check: ret
@run 32 -2 -> 65534 | 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 | fe ff 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00
@run 1 -2 -> !bounds | 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 | fe ff 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00

