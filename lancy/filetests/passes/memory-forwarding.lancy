# Forward an exact read regardless of the scalar type.
fn main p:ptr x:i32 -> i32
  a = cast f64 x
  store p a
  read = load f64 p
  out = cast i32 read
  ret out
@source check: load F64
@opt check: store
@opt not: load
@opt check: ret
@run 7 -> 7 | aa aa aa aa aa aa aa aa | 00 00 00 00 00 00 1c 40

