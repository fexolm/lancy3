# A trap between exact stores exposes the first one.
fn main p:ptr i:i32 n:i32 x:i32 y:i32 -> i32
  store p x
  bounds i n
  store p y
  ret y
@opt check: store
@opt check: bounds
@opt check: store
@run 1 1 5 7 -> !bounds | aa aa aa aa | 05 00 00 00
@run 0 1 5 7 -> 7 | aa aa aa aa | 07 00 00 00

