fn main p:ptr x:i32 y:i32 -> i32
  zero = const 0
  lane = cast u16 x
  two = literal u16 2
  a = simd.splat lane
  b = simd.splat two
  store p x
  quotient = simd.div a b
  store p y
  low = simd.extract quotient zero
  out = cast i32 low
  ret out
@opt not: store
@opt check: simd.Binary(Div)
@opt check: store
@opt check: ret
@run 10 7 -> 5 | aa aa aa aa | 07 00 00 00

