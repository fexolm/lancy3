# An overwrite on only one branch cannot kill an earlier store.
fn main p:ptr flag:i32 x:i32 y:i32 -> i32
  store p x
  br flag overwrite | done x
block overwrite
  store p y
  jump done y
block done result:i32
  ret result
@opt check: store
@opt check: br
@opt check: store
@run 0 5 7 -> 5 | aa aa aa aa | 05 00 00 00
@run 1 5 7 -> 7 | aa aa aa aa | 07 00 00 00
