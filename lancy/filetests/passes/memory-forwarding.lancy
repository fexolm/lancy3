# A constant nonzero divisor other than signed -1 cannot expose the first store.
fn main p:ptr x:i32 y:i32 -> i32
  wide = cast i64 x
  two = literal i64 2
  store p x
  quotient = div wide two
  store p y
  out = cast i32 quotient
  ret out
@opt not: store
@opt check: Div
@opt check: store
@opt not: store
@opt check: ret
@run 10 7 -> 5 | aa aa aa aa | 07 00 00 00

