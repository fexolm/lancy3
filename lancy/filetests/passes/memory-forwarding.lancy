# An overlapping read observes the original store.
fn main p:ptr x:i32 y:i32 -> i32
  two = const 2
  q = offset p two 1
  store p x
  read = load i32 q
  store p y
  ret read
@opt check: store
@opt check: load
@opt check: store
@run 0x11223344 0x55667788 -> 0x20101122 | aa aa aa aa 10 20 30 40 | 88 77 66 55 10 20 30 40

