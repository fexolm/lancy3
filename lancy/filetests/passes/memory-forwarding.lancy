# The value in the successful predecessor does not dominate the load.
fn main p:ptr n:i32 x:i32 -> i32
  br n yes | fail
block yes
  one = const 1
  a = add x one
  store p a
  jump join
block fail
  bounds n n
  jump join
block join
  read = load i32 p
  ret read
@opt check: load I32
@run 1 7 -> 8 | aa aa aa aa | 08 00 00 00
@run 0 7 -> !bounds | aa aa aa aa | aa aa aa aa

---

# A scalar write into the vector invalidates the earlier vector value.
fn main p:ptr x:i32 -> i32
  zero = const 0
  one = const 1
  two = const 2
  item = cast u16 zero
  v = simd.splat item
  simd.store p v
  middle = offset p one 4
  store middle x
  read = simd.load u16 p
  item_out = simd.extract read two
  out = cast i32 item_out
  ret out
@opt check: store
@opt check: simd.load U16
@run 0x12345678 -> 22136 | 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 | 00 00 00 00 78 56 34 12 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00

