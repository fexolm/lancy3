# Adjacent reads do not observe a store that will be overwritten.
fn main p:ptr x:i32 y:i32 -> i32
  four = const 4
  q = offset p four 1
  store p x
  read = load i32 q
  store p y
  ret read
@opt not: store
@opt check: load
@opt check: store
@opt not: store
@opt check: ret
@run 0x11223344 0x55667788 -> 0x40302010 | aa aa aa aa 10 20 30 40 | 88 77 66 55 10 20 30 40

