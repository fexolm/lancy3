# A narrow overwrite leaves part of a wider value observable.
fn main p:ptr -> i32
  zero = const 0
  wide = literal u64 1234567889abcdef
  narrow = literal u32 10203040
  store p wide
  store p narrow
  ret zero
@opt check: store
@opt check: store
@run -> 0 | aa aa aa aa aa aa aa aa | 40 30 20 10 78 56 34 12

