fn main p:ptr x:i32 y:i32 -> i32
  min = literal i64 8000000000000000
  minus_one = literal i64 ffffffffffffffff
  store p x
  quotient = div min minus_one
  store p y
  out = cast i32 quotient
  ret out
@opt check: store
@opt check: Div
@opt check: store
@run 5 7 -> !overflow | aa aa aa aa | 05 00 00 00

