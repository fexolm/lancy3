fn main p:ptr x:i32 -> i32
  a = cast u16 x
  z = const 0
  addr = offset p z 2
  store addr a
  read = load u16 p
  out = cast i32 read
  ret out
@opt check: store
@opt not: load
@opt check: ret
@run -2 -> 65534 | aa aa bb bb | fe ff bb bb

