# A wrapping sum of an affine sequence, with forwarding on the loop edges.
fn main n:i32 initial:i32 step:i32 -> i32
  zero = const 0
  one = const 1
  jump head zero initial zero step
block head i:i32 term:i32 acc:i32 delta:i32
  more = lt i n
  br more body i term acc delta | done acc
block body current_i:i32 current_term:i32 current_acc:i32 current_delta:i32
  next_i = add current_i one
  next_acc = add current_acc current_term
  next_term = add current_term current_delta
  jump head next_i next_term next_acc current_delta
block done result:i32
  ret result
@source check: br
@opt not: br
@opt check: Mul
@opt not: br
@run 4 10 3 -> 58
@run 4 10 -3 -> 22
@run 0 10 3 -> 0
@run -2 10 3 -> 0
@run 2 2147483647 1 -> -1
@run 65537 0 1 -> -2147450880

---

# A sum of the next terms and an independently live final term.
fn main n:i32 initial:i32 step:i32 -> i32
  zero = const 0
  one = const 1
  jump head zero initial zero
block head i:i32 term:i32 acc:i32
  more = lt i n
  br more body | done
block body
  next_i = add i one
  next_term = add term step
  next_acc = add acc next_term
  jump head next_i next_term next_acc
block done
  result = add acc term
  ret result
@opt not: br
@opt check: Mul
@opt not: br
@run 4 10 3 -> 92
@run 0 10 3 -> 10

---

# Runtime start, signed bounds, and a scaled induction value.
fn main start:i32 bound:i32 k:i32 b:i32 seed:i32 -> i32
  one = const 1
  jump head start seed
block head i:i32 acc:i32
  more = lt i bound
  br more body | done acc
block body
  next_i = add i one
  scaled = mul i k
  term = add scaled b
  next_acc = add acc term
  jump head next_i next_acc
block done out:i32
  ret out
@opt not: br
@opt check: And
@opt not: br
@run -2 3 4 7 9 -> 44
@run 3 6 -2 5 7 -> -2
@run 4 -5 7 0 23 -> 23

---

# The increment uses an already-quadratic recurrence. Keep the degree-three loop.
fn main n:i32 -> i32
  zero = const 0
  one = const 1
  jump head zero zero zero
block head i:i32 a:i32 b:i32
  more = lt i n
  br more body | done b
block body
  next_i = add i one
  next_a = add a i
  next_b = add b a
  jump head next_i next_a next_b
block done result:i32
  ret result
@opt check: br
@run 5 -> 10

---

# A store of each partial sum is observable even if the final sum is closed-form.
fn main p:ptr n:i32 step:i32 -> i32
  zero = const 0
  one = const 1
  jump head zero zero
block head i:i32 acc:i32
  more = lt i n
  br more body | done acc
block body
  next_i = add i one
  next_acc = add acc step
  address = offset p i 4
  store address next_acc
  jump head next_i next_acc
block done result:i32
  ret result
@opt check: br
@opt check: store
@run 2 11 -> 22 | aa aa aa aa aa aa aa aa | 0b 00 00 00 16 00 00 00
