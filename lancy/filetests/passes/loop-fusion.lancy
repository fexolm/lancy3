# Two arbitrary raw pointer arguments have no disjointness contract.
fn main src:ptr dst:ptr n:i32 -> i32
  zero = const 0
  one = const 1
  jump first zero
block first i:i32
  more = lt i n
  br more first_body | bridge
block first_body
  addr_a = offset src i 4
  next_i = add i one
  store addr_a next_i
  jump first next_i
block bridge
  jump second zero
block second j:i32
  more_b = lt j n
  br more_b second_body | done
block second_body
  addr_b = offset dst j 4
  store addr_b zero
  next_j = add j one
  jump second next_j
block done
  ret n
@opt check: br
@opt check: br

