# Two independent reductions with live, non-affine carries share one counter.
fn main n:i32 x:i32 y:i32 -> i32
  zero = const 0
  one = const 1
  a_factor = const 31
  b_factor = const 7
  jump first zero x
block first i:i32 a:i32
  more = lt i n
  br more first_body | bridge
block first_body
  mixed_a = xor a i
  next_a = mul mixed_a a_factor
  next_i = add i one
  jump first next_i next_a
block bridge
  jump second zero y
block second j:i32 b:i32
  more_b = lt j n
  br more_b second_body | done
block second_body
  mixed_b = xor b j
  next_b = mul mixed_b b_factor
  next_j = add j one
  jump second next_j next_b
block done
  total = add a b
  ret total
@source check: br
@source check: br
@opt check: br
@opt not: br
@opt check: ret
@run 3 5 7 -> 150298
@run 0 5 7 -> 12
@run -1 5 7 -> 12

---

# A pointwise producer and consumer of the same storage preserve ordering.
fn main p:ptr n:i32 -> i32
  zero = const 0
  one = const 1
  six = const 6
  jump first zero
block first i:i32
  more = lt i n
  br more first_body | bridge
block first_body
  addr_a = offset p i 4
  next_i = add i one
  store addr_a next_i
  jump first next_i
block bridge
  jump second zero
block second j:i32
  more_b = lt j n
  br more_b second_body | done
block second_body
  addr_b = offset p j 4
  input = load i32 addr_b
  result = add input six
  store addr_b result
  next_j = add j one
  jump second next_j
block done
  ret n
@opt check: br
@opt not: br
@opt not: load
@opt check: store
@opt not: store
@opt check: ret
@run 2 -> 2 | 5a 00 00 00 5b 00 00 00 5c 00 00 00 | 07 00 00 00 08 00 00 00 5c 00 00 00
@run 0 -> 0 | 5a 00 00 00 5b 00 00 00 | 5a 00 00 00 5b 00 00 00

---

# The next element is produced by a later iteration of the first loop.
fn main p:ptr n:i32 -> i32
  zero = const 0
  one = const 1
  jump first zero
block first i:i32
  more = lt i n
  br more first_body | bridge
block first_body
  addr_a = offset p i 4
  next_i = add i one
  store addr_a next_i
  jump first next_i
block bridge
  jump second zero
block second j:i32
  more_b = lt j n
  br more_b second_body | done
block second_body
  next_j = add j one
  later = offset p next_j 4
  input = load i32 later
  output = offset p j 4
  store output input
  jump second next_j
block done
  ret n
@opt check: br
@opt check: br
@run 2 -> 2 | 5a 00 00 00 5b 00 00 00 5c 00 00 00 | 02 00 00 00 5c 00 00 00 5c 00 00 00

