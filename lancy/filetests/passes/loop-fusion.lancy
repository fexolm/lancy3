# A remaining bounds check may fail and must retain all first-loop stores.
fn main p:ptr n:i32 len:i32 -> i32
  zero = const 0
  one = const 1
  ten = const 10
  jump first zero
block first i:i32
  more = lt i n
  br more first_body | bridge
block first_body
  addr_a = offset p i 4
  next_i = add i one
  store addr_a next_i
  jump first next_i
block bridge
  jump second zero
block second j:i32
  more_b = lt j n
  br more_b second_body | done
block second_body
  bounds j len
  addr_b = offset p j 4
  input = load i32 addr_b
  result = add input ten
  store addr_b result
  next_j = add j one
  jump second next_j
block done
  ret n
@opt check: br
@opt check: br
@opt check: bounds
@run 3 1 -> !bounds | 5a 00 00 00 5b 00 00 00 5c 00 00 00 | 0b 00 00 00 02 00 00 00 03 00 00 00
@run 3 3 -> 3 | 5a 00 00 00 5b 00 00 00 5c 00 00 00 | 0b 00 00 00 0c 00 00 00 0d 00 00 00

