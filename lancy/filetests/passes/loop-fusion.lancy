# A possibly aliasing store can invalidate an otherwise known exact value.
fn main p:ptr n:i32 delta:i32 -> i32
  zero = const 0
  one = const 1
  seven = const 7
  nineteen = const 19
  factor = const 31
  q = offset p delta 4
  jump first zero zero
block first i:i32 a:i32
  more = lt i n
  br more first_body | bridge
block first_body
  direct = offset p i 4
  indirect = offset q i 4
  store direct seven
  store indirect nineteen
  sample = load i32 direct
  next_a = add a sample
  next_i = add i one
  jump first next_i next_a
block bridge
  jump second zero zero
block second j:i32 b:i32
  more_b = lt j n
  br more_b second_body | done
block second_body
  mix = xor b j
  next_b = mul mix factor
  next_j = add j one
  jump second next_j next_b
block done
  answer = add a b
  ret answer
@opt check: br
@opt check: store
@opt check: store
@opt check: load
@opt not: br
@opt check: ret
@run 2 0 -> 69 | 5a 00 00 00 5b 00 00 00 5c 00 00 00 | 13 00 00 00 13 00 00 00 5c 00 00 00
@run 2 1 -> 45 | 5a 00 00 00 5b 00 00 00 5c 00 00 00 | 07 00 00 00 07 00 00 00 13 00 00 00
