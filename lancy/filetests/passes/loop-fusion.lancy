# The second loop consumes the final first-loop carry through its body edge.
fn main n:i32 x:i32 y:i32 -> i32
  zero = const 0
  one = const 1
  a_factor = const 31
  b_factor = const 7
  jump first zero x
block first i:i32 a:i32
  more = lt i n
  br more first_body | bridge
block first_body
  mixed_a = xor a i
  next_a = mul mixed_a a_factor
  next_i = add i one
  jump first next_i next_a
block bridge
  jump second zero y
block second j:i32 b:i32
  more_b = lt j n
  br more_b second_body a | done
block second_body final_a:i32
  mixed_b = xor b final_a
  next_b = mul mixed_b b_factor
  next_j = add j one
  jump second next_j next_b
block done
  ret b
@opt check: br
@opt check: br
@run 2 5 7 -> 259399

