# The input is dynamic so all three conversions must execute. 128-bit
# conversions are cold and call the shared numeric fallback.
fn main(x:u128) -> i128
  half = cast bf16 x
  single = cast f32 half
  wide = cast i128 single
  ret wide
@isel check: fallback.u128.cast
@isel check: fallback.f32.cast
---
fn main(x:f64) -> u128
  wide = cast u128 x
  ret wide
@isel check: fallback.f64.cast
---
# 16-bit fused multiply-add has no x86 form below AVX512-FP16 and is cold:
# it calls the fallback, which rounds once.
fn main(x:f16 y:f16 z:f16) -> f16
  answer = fma x y z
  ret answer
@isel check: fallback.f16.fma
@run 0x3c00_f16 0x3c00_f16 0x3c00_f16 -> 0x4000_f16
---
fn main(x:vec.bf16 y:vec.bf16 z:vec.bf16) -> vec.bf16
  answer = fma x y z
  ret answer
@isel check: fallback.vec.bf16.fma
---
# Exposing the low address bits permits alignment arithmetic on a slice.
fn main(base:ptr i:i32) -> i32
  next = offset base i 4
  a = bitcast u64 base
  b = bitcast u64 next
  diff = sub b a
  result = cast i32 diff
  ret result
@asm check: endbr64
@asm not: call
@asm check: ret
@run 3 -> 12 | 00 | 00
