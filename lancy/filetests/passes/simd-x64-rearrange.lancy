# A positive shift draws from the first table and zero-fills low lanes.
fn main(bias:i32) -> i32
  i = iota i32
  one = const 1
  ones = splat one
  offsets = sub i ones
  base = splat bias
  table = add i base
  shifted = shuffle table ones offsets
  begin = ge i ones
  zero = const 0
  zeros = splat zero
  previous = add offsets base
  expected = select begin previous zeros
  bad = ne shifted expected
  result = any bad
  ret result
@isel regex: SHIFT=shift.dwords 1|native\.vec.i32\.shuffle
@isel check: $SHIFT
@run 19 -> 0
@run 2147483647 -> 0
---
# A negative shift can enter the second table at the upper end.
fn main(marker:i32) -> i32
  i = iota i32
  minus_one = const -1
  delta = splat minus_one
  offsets = sub i delta
  second = splat marker
  shifted = shuffle i second offsets
  n = lanes i32
  one = const 1
  last = sub n one
  result = extract shifted last
  ret result
@isel not: shift.dwords
@run 97 -> 97
---
# Compile-time in-range extraction reads a register lane.
fn main(bias:i32) -> i32
  seq = iota i32
  base = splat bias
  table = add seq base
  index = const 3
  result = extract table index
  ret result
@isel check: extract.i32 3
@run 5 -> 8
@run 2147483647 -> -2147483646
---
# Extract still traps for an invalid index, even with an unused result.
fn main(x:i32) -> i32
  table = splat x
  index = const -1
  unused = extract table index
  ret x
@isel check: fallback.vec.i32.extract
@run 7 -> !bounds
---
# Computing the second table can trap even when all selected lanes come from the first.
fn main(divisor:i32) -> i32
  i = iota i32
  one = const 1
  splat = splat one
  indices = sub i splat
  divisors = splat divisor
  second = div splat divisors
  shifted = shuffle i second indices
  result = any shifted
  ret result
@run 0 -> !zero
@run 1 -> -1
---
fn main(bias:i32) -> i32
  i = iota i32
  b = splat bias
  data = add i b
  one = const 1
  ones = splat one
  even = add i i
  odd = add even ones
  out = shuffle i data odd
  n = lanes i32
  last = sub n one
  value = extract out last
  answer = sub value last
  ret answer
@isel regex: SHUFFLE=shuffle\.deinterleave\.hi|lanes\.vec.i32\.shuffle
@isel check: $SHUFFLE
@run 71 -> 71
---
# The last index is just past the second table.
fn main(bias:i32) -> i32
  i = iota i32
  b = splat bias
  data = add i b
  two = const 2
  twos = splat two
  even = add i i
  idx = add even twos
  out = shuffle data data idx
  n = lanes i32
  one = const 1
  last = sub n one
  value = extract out last
  ret value
@isel check: arg 0
@isel not: shuffle.deinterleave
@isel check: ret
@run 71 -> 0
---
fn main(p:ptr index:i32 replacement:i32) -> i32
  one = const 1
  store p one
  i = iota i32
  replaced = insert i index replacement
  a = reduce add replaced
  b = reduce add i
  result = sub a b
  next = offset p one 4
  store next result
  ret result
@isel regex: INSERT=insert\.i32\.checked
@isel check: $INSERT
@run 3 99 -> 96 | aa aa aa aa ff ff ff ff | 01 00 00 00 60 00 00 00
@run -1 99 -> !bounds | aa aa aa aa ff ff ff ff | 01 00 00 00 ff ff ff ff
@run 16 99 -> !bounds | aa aa aa aa ff ff ff ff | 01 00 00 00 ff ff ff ff
