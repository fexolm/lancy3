# Counts in neighboring lanes differ. The high bits in a count are ignored.
fn main(x:i32 count:i32) -> i32
  data = splat x
  counts = splat count
  iota = iota i32
  per_lane = add counts iota
  shifted = shl data per_lane
  rotated = rotateright shifted per_lane
  lane = const 1
  result = extract rotated lane
  ret result
@source check: = shl
@source check: = rotateright
@isel check: arg 0
@isel not: packed.i32.shl imm=
@isel not: packed.i32.rotateright imm=
@isel check: ret
@asm check: endbr64
@asm not: call
@asm check: ret
@run 0x40000001 31 -> 0x40000001
@run 0x40000001 32 -> 0x40000001
@run 0x80000001 32 -> 1
---
# The low byte of each product wraps. Compare through the unsigned sign boundary.
fn main(x:i32 y:i32) -> i32
  x8 = cast u8 x
  y8 = cast u8 y
  a = splat x8
  b = splat y8
  prod = mul a b
  high = ge prod a
  answer = any high
  ret answer
@source check: = mul
@source check: = ge
@asm check: endbr64
@asm not: call
@asm check: ret
@run 127 2 -> -1
@run 128 2 -> 0
@run 255 1 -> -1
---
# The immediate is reduced modulo 32. Signed right shift replicates the sign.
fn main(x:i32) -> i32
  data = splat x
  count = const 33
  counts = splat count
  shifted = shr data counts
  lane = const 0
  result = extract shifted lane
  ret result
@isel regex: SHR=packed\.i32\.shr imm=1|lanes\.vec.i32\.shr
@isel check: $SHR
@run 0x80000004 -> -1073741822
@run 7 -> 3
