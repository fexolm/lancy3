fn main(base:ptr i:i32 len:i32) -> i32
  bounds i len
  bounds i len
  addr = offset base i 4
  value = load i32 addr
  ret value

@source check: bounds
@source nextln: bounds
@opt check: bounds
@opt not: bounds
@opt check: offset
@isel check: bounds
@isel nextln: movsxd
@isel nextln: load.I32 scale=4 disp=0
@isel not: lea
@asm check: cmp
@asm check: jae
@asm check: movsxd
@asm check: *4]
@run 1 2 -> -2 | 03 00 00 00 fe ff ff ff | 03 00 00 00 fe ff ff ff
@run -1 2 -> !bounds | 03 00 00 00 fe ff ff ff | 03 00 00 00 fe ff ff ff

---

fn main(cond:i32 i:i32 len:i32) -> i32
  br cond left() | right()
block left()
  bounds i len
  jump join()
block right()
  jump join()
block join()
  bounds i len
  jump tail()
block tail()
  bounds i len
  ret i

@source check: jump b4()
@source nextln: block b4()
@source nextln: bounds
@opt check: br v0 b1() | b2()
@opt nextln: block b1()
@opt nextln: bounds
@opt check: block b2()
@opt nextln: jump b3()
@opt nextln: block b3()
@opt nextln: bounds
@opt nextln: jump b4()
@opt nextln: block b4()
@opt nextln: ret
@run 0 1 1 -> !bounds
@run 1 0 1 -> 0
