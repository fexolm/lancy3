fn main n:i32 x:i32 y:i32 -> i32
  z = const 0
  one = const 1
  jump head z z
block head i:i32 acc:i32
  more = lt i n
  br more body | done acc
block body
  term = mul x y
  adjusted = add term x
  variant = mul i y
  total = add acc adjusted
  new = add total variant
  next = add i one
  jump head next new
block done v:i32
  ret v
@source check: br
@source check: Mul
@opt check: Mul v1 v2
@opt nextln: Add
@opt nextln: jump
@opt check: br
@opt check: Mul
@run 0 9 2 -> 0
@run 3 9 2 -> 87
@run 3 2147483647 2 -> 2147483645

---

# Integer division can trap even with invariant operands.
fn main n:i32 x:i32 y:i32 -> i32
  z = const 0
  one = const 1
  jump head z z
block head i:i32 acc:i32
  more = lt i n
  br more body | done acc
block body
  term = div x y
  new = add acc term
  next = add i one
  jump head next new
block done v:i32
  ret v
@opt check: br
@opt check: Div v1 v2
@run 0 7 0 -> 0
@run 1 7 0 -> !zero
@run 1 -2147483648 -1 -> !overflow
