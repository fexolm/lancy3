# Like Rust's `signum`, every backend turns a NaN into the canonical quiet NaN.
fn main bits:i32 -> i32
  f = bitcast f32 bits
  out = signum f
  r = bitcast i32 out
  ret r
@run 0 -> 0x3f800000
@run 0x80000000 -> 0xbf800000
@run 0xff800001 -> 0x7fc00000
@run 0x7fc01234 -> 0x7fc00000
---
fn main bits:i32 -> i32
  raw = cast u16 bits
  f = bitcast f16 raw
  out = signum f
  word = bitcast u16 out
  r = cast i32 word
  ret r
@run 0xfc01 -> 0x7e00
@run 0x8001 -> 0xbc00
