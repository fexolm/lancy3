# A positive mask has no active lanes, even when it is nonzero.
fn main(p:ptr x:i32) -> i32
  one = const 1
  mask = splat one
  values = splat x
  zero = const 0
  other = splat zero
  maskedstore p - mask values
  loaded = maskedload p - mask values
  chosen = select mask other loaded
  answer = extract chosen zero
  ret answer
@opt not: vec.
@opt check: ret
@run 42 -> 42 | ad de fe ca | ad de fe ca
---
# Active scatter still writes repeated indices in lane order.
fn main(p:ptr) -> i32
  negative = const -1
  mask = splat negative
  zero = const 0
  indices = splat zero
  values = iota i32
  maskedstore p indices mask values
  ret zero
@opt check: maskedstore
---
fn main(x:i32 y:i32) -> i32
  i = iota i32
  a = splat x
  b = splat y
  twice = splat x
  chosen = shuffle a b i
  merged = add chosen twice
  zero = const 0
  ret_value = extract merged zero
  ret ret_value
@opt check: = splat
@opt not: = splat
@opt not: = shuffle
@opt check: ret
@run 4 13 -> 8
---
# Composing broadcasts preserves an inner out-of-range index's zeros.
fn main(x:i32 y:i32 i:i32) -> i32
  a = splat x
  b = splat y
  indices = splat i
  first = shuffle a b indices
  zero = const 0
  zeros = splat zero
  broadcast = shuffle first b zeros
  result = extract broadcast zero
  ret result
@opt check: = shuffle
@opt not: = shuffle
@opt check: ret
@run 3 7 0 -> 3
@run 3 7 -1 -> 0
---
fn main(x:i32) -> i32
  v = splat x
  zero = const 0
  count = lanes i32
  changed = insert v zero zero
  first = extract changed zero
  invalid = extract v count
  ret first
@opt not: = insert
@opt check: = extract
@opt not: = extract
@opt check: ret
@run 77 -> !bounds
---
# Only the splat of the invariant value can move before the loop.
fn main(n:i32 x:i32) -> i32
  zero = const 0
  one = const 1
  jump head(zero zero)
block head(i:i32 acc:i32)
  more = lt i n
  br more body() | done(acc)
block body()
  fixed = splat x
  changing = splat i
  sum = add fixed changing
  first = extract sum zero
  total = add first acc
  next = add i one
  jump head(next total)
block done(output:i32)
  ret output
@opt check: vec.i32 = splat v1
@opt nextln: jump
@opt check: br
@opt check: vec.i32 = splat
@run 0 7 -> 0
@run 3 7 -> 24
---
# Only one scalar word is readable at the broadcast address.
fn main(p:ptr x:i32) -> i32
  zero = const 0
  v = splat x
  scalar = load i32 p
  splat = splat scalar
  out = and v splat
  answer = extract out zero
  ret answer
@run 127 -> 60 | bc 00 00 00 | bc 00 00 00
---
# An intervening store aliases the vector load. The old bytes must be returned.
fn main(p:ptr x:i32) -> i32
  z = const 0
  v = splat x
  old = load vec.i32 p
  store p z
  masked = and old v
  answer = extract masked z
  ret answer
@isel check: load.vec.i32
@isel check: store.i32
@isel not: packed.and.mem
@run 127 -> 60 | bc 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 | 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00
