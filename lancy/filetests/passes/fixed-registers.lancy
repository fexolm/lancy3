fn main(x:i32 y:i32) -> i32
  rest = rem x y
  result = shl rest y
  ret result

@opt check: = rem
@opt nextln: = shl
@isel check: divide.high.i32
@isel nextln: rem.i32
@isel nextln: shl
@alloc check: divide.high.i32 | rax rdx
@alloc check: rem.i32 | rax rdx
@alloc sameln: rdx
@alloc check: shl.i32 |
@alloc sameln: rcx
@asm check: cdq
@asm check: idiv
@asm check: shl
@asm sameln: ,cl
@run -17 3 -> -16
@run 101 0 -> !zero
@run -2147483648 -1 -> !overflow
