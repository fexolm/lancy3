# A known nonzero signed divisor other than -1 licenses motion.
fn main(n:i32 x:i32) -> i32
  zero = const 0
  one = const 1
  two = literal i64 2
  jump head(zero zero)
block head(i:i32 acc:i32)
  more = lt i n
  br more body() | done(acc)
block body()
  numerator = cast i64 x
  divided = div numerator two
  value = cast i32 divided
  sum = xor acc value
  next = add i one
  jump head(next sum)
block done(result:i32)
  ret result
@source check: br
@source check: = div
@opt check: = div
@opt check: jump
@opt check: br
@opt not: = div
@opt check: ret
@run 0 -7 -> 0
@run 3 -7 -> -3

