# The SIMD expression chain is invariant except for the splat of the induction value.
fn main(n:i32 x:i32 y:i32) -> i32
  zero = const 0
  one = const 1
  jump head(zero zero)
block head(i:i32 acc:i32)
  more = lt i n
  br more body() | done(acc)
block body()
  fixed = splat x
  ramp = iota i32
  adjusted = add fixed ramp
  other = splat y
  mask = lt ramp other
  chosen = select mask adjusted other
  changing = splat i
  mixed = add chosen changing
  lane = extract mixed zero
  sum = xor acc lane
  next = add i one
  jump head(next sum)
block done(result:i32)
  ret result
@source check: br
@source check: = iota
@opt check: vec.i32 = splat v1
@opt check: = iota
@opt check: = add
@opt check: = select
@opt check: jump
@opt check: br
@opt check: vec.i32 = splat
@opt check: = add
@run 0 7 4 -> 0
@run 3 7 4 -> 6
@run 3 7 -5 -> -6

