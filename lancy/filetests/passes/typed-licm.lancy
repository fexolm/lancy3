# A dominating signed length comparison proves the entire immutable vector readable.
fn main p:ptr len:i32 n:i32 -> i32
  slices 0 read4
  zero = const 0
  one = const 1
  width = simd.lanes f32
  full = ge len width
  br full preheader | short
block short
  ret zero
block preheader
  jump head zero zero
block head i:i32 acc:i32
  more = lt i n
  br more body | done acc
block body
  addr = offset p zero 4
  packet = simd.load f32 addr
  coeff = simd.extract packet zero
  term = cast i32 coeff
  sum = xor acc term
  next = add i one
  jump head next sum
block done result:i32
  ret result
@source check: br
@source check: br
@source check: simd.load F32
@opt check: br
@opt check: simd.load F32
@opt check: jump
@opt check: br
@opt not: simd.load F32
@opt check: ret
@run 16 3 -> 3 | 00 00 40 40 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 | 00 00 40 40 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00
@run 1 3 -> 0 | 00 00 40 40 | 00 00 40 40

