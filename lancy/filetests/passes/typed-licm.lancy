# The checked immutable eight-byte element can be loaded before the loop.
fn main(p:ptr len:i32 n:i32) -> i32
  slice p len read8
  zero = const 0
  one = const 1
  bounds zero len
  jump head(zero zero)
block head(i:i32 acc:i32)
  more = lt i n
  br more body() | done(acc)
block body()
  bounds zero len
  addr = offset p zero 8
  coeff = load f64 addr
  term = cast i32 coeff
  sum = xor acc term
  next = add i one
  jump head(next sum)
block done(result:i32)
  ret result
@source check: br
@source check: load f64
@opt check: bounds
@opt check: load f64
@opt check: jump
@opt check: br
@opt not: load f64
@opt check: ret
@run 1 0 -> 0 | 00 00 00 00 00 00 1c 40 | 00 00 00 00 00 00 1c 40
@run 1 3 -> 7 | 00 00 00 00 00 00 1c 40 | 00 00 00 00 00 00 1c 40
@run 0 0 -> !bounds | |

