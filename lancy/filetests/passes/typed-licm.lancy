# The same address in a writable slice must be reloaded after the previous store.
fn main(p:ptr len:i32 n:i32) -> i32
  slice p len write8
  zero = const 0
  one = const 1
  one64 = literal i64 1
  bounds zero len
  jump head(zero zero)
block head(i:i32 acc:i32)
  more = lt i n
  br more body() | done(acc)
block body()
  addr = offset p zero 8
  current = load i64 addr
  updated = add current one64
  store addr updated
  result = cast i32 updated
  next = add i one
  jump head(next result)
block done(result_out:i32)
  ret result_out
@opt not: load i64
@opt check: br
@opt check: load i64
@opt check: store
@run 1 0 -> 0 | 07 00 00 00 00 00 00 00 | 07 00 00 00 00 00 00 00
@run 1 2 -> 9 | 07 00 00 00 00 00 00 00 | 09 00 00 00 00 00 00 00

