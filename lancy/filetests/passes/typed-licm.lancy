# A SIMD signed division by -1 can overflow in the loop body.
fn main(n:i32 x:i32) -> i32
  zero = const 0
  one = const 1
  minus_one = literal i16 ffff
  jump head(zero zero)
block head(i:i32 acc:i32)
  more = lt i n
  br more body() | done(acc)
block body()
  numerator = cast i16 x
  a = splat numerator
  b = splat minus_one
  quotient = div a b
  item = extract quotient zero
  value = cast i32 item
  sum = xor acc value
  next = add i one
  jump head(next sum)
block done(result:i32)
  ret result
@opt not: = div
@opt check: br
@opt check: = div
@run 0 -32768 -> 0
@run 1 -32768 -> !overflow
@run 3 -7 -> 7

