# Typed scalar arithmetic and its casts are available before the loop.
fn main(n:i32 x:i32 y:i32) -> i32
  zero = const 0
  one = const 1
  jump head(zero zero)
block head(i:i32 acc:i32)
  more = lt i n
  br more body() | done(acc)
block body()
  a = cast f64 x
  b = cast f64 y
  product = mul a b
  term = cast i32 product
  sum = xor acc term
  next = add i one
  jump head(next sum)
block done(result:i32)
  ret result
@source check: br
@source check: = cast f64
@source check: = mul
@opt check: = cast f64
@opt check: = cast f64
@opt check: = mul
@opt check: = cast i32
@opt check: jump
@opt check: br
@opt not: = mul
@opt check: = xor
@run 0 3 7 -> 0
@run 3 3 7 -> 21
@run 3 -3 7 -> -21

