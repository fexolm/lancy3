# A dominating signed length comparison proves the entire immutable vector readable.
fn main(p:ptr len:i32 n:i32) -> i32
  slice p len read4
  zero = const 0
  one = const 1
  width = lanes f32
  full = ge len width
  br full preheader() | short()
block short()
  ret zero
block preheader()
  jump head(zero zero)
block head(i:i32 acc:i32)
  more = lt i n
  br more body() | done(acc)
block body()
  addr = offset p zero 4
  packet = load vec.f32 addr
  coeff = extract packet zero
  term = cast i32 coeff
  sum = xor acc term
  next = add i one
  jump head(next sum)
block done(result:i32)
  ret result
@source check: br
@source check: br
@source check: load vec.f32
@opt check: br
@opt check: load vec.f32
@opt check: jump
@opt check: br
@opt not: load vec.f32
@opt check: ret
