# A dynamic extract cannot be moved from a loop that might never run.
fn main(n:i32 x:i32 index:i32) -> i32
  zero = const 0
  one = const 1
  jump head(zero zero)
block head(i:i32 acc:i32)
  more = lt i n
  br more body() | done(acc)
block body()
  v = splat x
  item = extract v index
  sum = xor acc item
  next = add i one
  jump head(next sum)
block done(result:i32)
  ret result
@opt check: = splat
@opt not: = extract
@opt check: br
@opt check: = extract
@run 0 7 64 -> 0
@run 1 7 64 -> !bounds
@run 3 7 0 -> 7

