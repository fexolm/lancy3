# An adjacent loop with two incoming edges has no preheader for its iota.
fn main(n:i32 pick:i32) -> i32
  zero = const 0
  one = const 1
  jump first(zero zero)
block first(i:i32 acc:i32)
  more = lt i n
  br more first_body() | choose()
block first_body()
  value = xor acc i
  next = add i one
  jump first(next value)
block choose()
  br pick a() | b()
block a()
  add_one = add acc one
  jump second(zero add_one)
block b()
  sub_one = sub acc one
  jump second(zero sub_one)
block second(j:i32 sum:i32)
  more_b = lt j n
  br more_b second_body() | done()
block second_body()
  lanes = iota i32
  lane = extract lanes zero
  value_b = xor sum lane
  next_b = add j one
  jump second(next_b value_b)
block done()
  ret sum
@opt check: br
@opt check: = iota
@run 0 1 -> 1
@run 2 1 -> 2
@run 2 0 -> 0
