---
# The mask also supplies the signed indices and passthrough. Only lane zero
# is inactive. All active lanes scatter to the same word; the last wins.
fn main(p:ptr inactive:i32) -> i32
  zero = const 0
  one = const 1
  minus_one = const -1
  base = offset p one 4
  negative = splat minus_one
  indices = insert negative zero inactive
  gathered = maskedload base indices indices indices
  lanes = iota i32
  count = lanes i32
  last = sub count one
  last_lane = splat last
  replacements = eq lanes last_lane
  maskedstore base indices indices replacements
  inactive_value = extract gathered zero
  first_value = extract gathered one
  result = add inactive_value first_value
  ret result
@isel check: maskedload.vec.i32
@isel check: maskedstore.vec.i32
