# The outer branch chooses one of two loops. The accumulator is used directly
# outside the original loop and must be joined across both copies.
fn main n:i32 mode:i32 -> i32
  z = const 0
  one = const 1
  jump head z z
block head i:i32 acc:i32
  more = lt i n
  br more choose | done
block choose
  br mode yes | no
block yes
  total = add acc one
  jump latch total
block no
  other = sub acc one
  jump latch other
block latch sum:i32
  next = add i one
  jump head next sum
block done
  ret acc
@source check: br v1
@opt not: Lt
@opt check: br v1
@opt check: Lt
@opt check: br
@opt check: Lt
@opt check: br
@opt not: br
@run 0 0 -> 0
@run 0 1 -> 0
@run 3 0 -> -3
@run 3 -1 -> 3

---

# A condition that changes with the induction variable stays in the loop.
fn main n:i32 -> i32
  z = const 0
  one = const 1
  jump head z z
block head i:i32 acc:i32
  more = lt i n
  br more choose | done
block choose
  first = eq i z
  br first yes | no
block yes
  total = add acc one
  jump latch total
block no
  other = sub acc one
  jump latch other
block latch sum:i32
  next = add i one
  jump head next sum
block done
  ret acc
@opt not: br
@opt check: Lt
@opt check: br
@opt check: Eq
@opt check: br
@opt not: br
@run 0 -> 0
@run 1 -> 1
@run 3 -> -1

---

# Reaching the invariant operands does not make the division safe to speculate.
fn main n:i32 divisor:i32 -> i32
  z = const 0
  one = const 1
  jump head z z
block head i:i32 acc:i32
  more = lt i n
  br more choose | done
block choose
  test = div one divisor
  br test yes | no
block yes
  total = add acc one
  jump latch total
block no
  other = sub acc one
  jump latch other
block latch sum:i32
  next = add i one
  jump head next sum
block done
  ret acc
@opt not: Div
@opt check: Lt
@opt check: br
@opt check: Div
@opt check: br
@run 0 0 -> 0
@run 1 0 -> !zero
@run 3 1 -> 3
@run 3 2 -> -3
