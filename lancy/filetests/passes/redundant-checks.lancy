# A conditional trap that a dominating trap of the same kind on the same
# condition already made is removed (HIR-18).
fn main(x:i32 y:i32) -> i32
  c = lt x y
  trap_if c Overflow
  s = add x y
  trap_if c Overflow
  ret s
@opt check: trap_if
@opt not: trap_if
@run 2 1 -> 3
@run 1 2 -> !arithmetic_overflow

---

# A different trap kind on the same condition stays.
fn main(x:i32 y:i32) -> i32
  c = lt x y
  trap_if c Overflow
  trap_if c Bounds
  ret x
@opt check: trap_if v2 Overflow
@opt nextln: trap_if v2 Bounds
@run 2 1 -> 2

---

# In a loop, `j` always carries `k`, so its facts root is `k` and its
# bounds check repeats the one before the loop. A cyclic function keeps the
# parameter, so the check matches only by root.
fn main(n:i32 m:i32 k:i32) -> i32
  zero = const 0
  one = const 1
  bounds k m
  jump head(zero k)
block head(i:i32 j:i32)
  more = lt i n
  br more body() | done()
block body()
  bounds j m
  next = add i one
  jump head(next j)
block done()
  ret i
@opt check: bounds
@opt not: bounds
@run 3 5 1 -> 3
@run 3 2 4 -> !bounds

---

# An unused load that a dominating check proves inside a declared slice
# cannot trap and is dead; the used load stays (HIR-19).
fn main(p:ptr len:i32 q:ptr room:i32 k:i32) -> i32
  slice p len read4
  slice q room write4
  bounds k len
  at = offset p k 4
  half = load i16 at
  x = load i32 at
  ret x
@opt not: load i16
@opt check: load i32
@opt not: load
@run 2 1 1 -> 9 | 07 00 00 00 09 00 00 00 | 07 00 00 00 09 00 00 00 | 00 00 00 00 | 00 00 00 00

---

# An unused load through a raw pointer may fault, so it stays.
fn main(p:ptr q:ptr) -> i32
  zero = const 0
  unused = load i32 q
  used = load i32 p
  ret used
@opt check: load
@opt nextln: load
