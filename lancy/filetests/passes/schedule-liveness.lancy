# The use of b in sibling cannot extend its life in work.
fn main(route:i32 a:i32 b:i32 c:i32 d:i32 e:i32) -> i32
  mask = const 17
  br route work() | sibling()
block sibling()
  ret b
block work()
  t0 = mul b d
  t1 = add a d
  t2 = sub t1 t0
  t3 = xor t0 mask
  t4 = add t2 c
  t5 = or e b
  t6 = mul t4 t3
  answer = sub t6 t5
  ret answer
@isel check: alu.Sub
@isel check: alu.Xor imm=17
@isel check: alu.Or
@alloc check: alu.Or
@alloc check: alu.Sub
@alloc check: alu.Xor imm=17
@run 0 4 3 2 5 8 -> 3
@run -2 4 3 2 5 8 -> -131

---

# Every use of b is in work, but it remains live across the backedge.
fn main(p:ptr n:i32 b:i32) -> i32
  zero = const 0
  one = const 1
  ka = const 4
  kc = const 2
  kd = const 5
  ke = const 8
  mask = const 17
  jump head(zero)
block head(i:i32)
  a = add i ka
  c = add i kc
  d = add i kd
  e = add i ke
  more = lt i n
  br more work() | done()
block work()
  t0 = mul b d
  t1 = add a d
  t2 = sub t1 t0
  t3 = xor t0 mask
  t4 = add t2 c
  t5 = or e b
  t6 = mul t4 t3
  answer = sub t6 t5
  jump latch()
block latch()
  store p answer
  next = add i one
  jump head(next)
block done()
  ret i
@alloc check: alu.Mul
@alloc check: alu.Sub
@alloc check: alu.Xor imm=17
@alloc check: alu.Or
@alloc check: store.I32
@run 0 3 -> 0 | aa aa aa aa | aa aa aa aa
@run 1 3 -> 1 | aa aa aa aa | 7d ff ff ff
@run 2 3 -> 2 | aa aa aa aa | e9 ff ff ff

---

# b escapes work as an argument from a critical-edge bridge.
fn main(route:i32 take:i32 a:i32 b:i32 c:i32 d:i32 e:i32) -> i32
  mask = const 17
  br route work() | sibling()
block sibling()
  jump merge(e c)
block work()
  t0 = mul b d
  t1 = add a d
  t2 = sub t1 t0
  t3 = xor t0 mask
  t4 = add t2 c
  t5 = or e b
  t6 = mul t4 t3
  answer = sub t6 t5
  br take merge(answer b) | plain()
block plain()
  ret answer
block merge(sum:i32 carried:i32)
  result = add sum carried
  ret result
@alloc check: alu.Sub
@alloc check: alu.Xor imm=17
@alloc check: alu.Or
@run 0 1 4 3 2 5 8 -> 10
@run -2 0 4 3 2 5 8 -> -131
@run -2 -1 4 3 2 5 8 -> -128

---

# The last local use of b follows a scheduling barrier.
fn main(a:i32 b:i32 c:i32 d:i32 e:i32 divisor:i32) -> i32
  mask = const 17
  t0 = mul b d
  t1 = add a d
  t2 = sub t1 t0
  t3 = xor t0 mask
  t4 = add t2 c
  t5 = or e b
  t6 = mul t4 t3
  answer = sub t6 t5
  quot = div answer divisor
  result = add quot b
  ret result
@alloc check: alu.Sub
@alloc check: alu.Xor imm=17
@alloc check: alu.Or
@alloc check: idiv
@run 4 3 2 5 8 2 -> -62
@run 4 3 2 5 8 0 -> !zero
