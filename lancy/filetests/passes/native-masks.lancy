# Select uses the sign bit of each lane. Any accepts every nonzero bit pattern.
fn main(mask:i32 value:i32) -> i32
  masks = splat mask
  yes = splat value
  no = not masks
  chosen = select masks yes no
  result = any chosen
  ret result
@isel regex: FREE_RESULT=Def: v[0-9]+v reg
@isel check: native.Vector(I32).Ternary(Select)
@isel sameln: $FREE_RESULT
@asm check: endbr64
@asm not: call
@asm check: ret
@run -1 0 -> 0
@run -1 1 -> -1
@run 1 0 -> -1
@run 0x80000000 0 -> 0
---
# Only the last lane is zero after adding -(width-1).
fn main(x:i32) -> i32
  n = lanes i32
  b = sub x n
  delta = splat b
  indices = iota i32
  shifted = add indices delta
  result = all shifted
  ret result
@asm check: endbr64
@asm not: call
@asm check: ret
@run 0 -> -1
@run 1 -> 0
---
# Only the upper word of each i128 lane can be nonzero. Select tests its sign.
fn main(x:i32) -> i32
  input = cast i128 x
  shift = literal i128 40
  high = shl input shift
  masks = splat high
  zero = literal i128 0
  one = literal i128 1
  zeros = splat zero
  ones = splat one
  chosen = select masks ones zeros
  sign = any chosen
  any = any masks
  all = all masks
  first = const 0
  mixed = insert masks first zero
  mixed_all = all mixed
  counts = add any all
  signs = add sign mixed_all
  result = add counts signs
  ret result
@run 0 -> 0
@run 1 -> -2
@run -1 -> -3
---
# Bounds checks see any nonzero bit in an enabled lane.
fn main(x:i32 active:i32) -> i32
  zero = const 0
  one = const 1
  xs = splat x
  zs = splat zero
  cmp = lt xs zs
  enabled = splat active
  masked = and enabled cmp
  bad = any masked
  bounds bad one
  ret zero
@isel check: bounds.mask
@run -1 1 -> !bounds
@run -1 0 -> 0
@run 1 -1 -> 0
---
# Select checks the high bit, including after AND with a comparison.
fn main(x:i32 active:i32) -> i32
  zero = const 0
  xs = splat x
  zs = splat zero
  cmp = lt xs zs
  enabled = splat active
  masked = and cmp enabled
  picked = select masked xs zs
  result = extract picked zero
  ret result
@isel regex: SELECT=select\.mask\.compare\.and|native\.Vector\(I32\)\.Ternary\(Select\)
@isel check: $SELECT
@run -7 1 -> 0
@run -7 0x80000000 -> -7
@run 7 0x80000000 -> 0
---
# The comparison also supplies a vector payload.
fn main(x:i32) -> i32
  zero = const 0
  xs = splat x
  zs = splat zero
  mask = lt xs zs
  picked = select mask mask zs
  result = extract picked zero
  ret result
@isel check: native.Vector(I32).Binary(Lt)
@isel check: native.Vector(I32).Ternary(Select)
@run -7 -> -1
@run 7 -> 0
---
# One active lane must only touch the provided word.
fn main(p:ptr value:i32) -> i32
  i = iota i32
  one = const 1
  ones = splat one
  first = lt i ones
  data = splat value
  maskedstore p - first data
  ret value
@isel check: maskedstore.Vector(I32)
@run 7 -> 7 | aa aa aa aa | 07 00 00 00
