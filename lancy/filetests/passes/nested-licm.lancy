fn main p:ptr n:i32 m:i32 q:i32 bias:i32 -> i32
  zero = const 0
  one = const 1
  jump outer zero
block outer i:i32
  a = lt i n
  br a middle_pre | done
block middle_pre
  jump middle zero
block middle j:i32
  b = lt j m
  br b inner_pre | outer_step
block inner_pre
  jump inner zero
block inner k:i32
  c = lt k q
  br c body | middle_step
block body
  outer_only = add i bias
  middle_dep = mul outer_only j
  value = add middle_dep k
  store p value
  k1 = add k one
  jump inner k1
block middle_step
  j1 = add j one
  jump middle j1
block outer_step
  i1 = add i one
  jump outer i1
block done
  ret i
@source check: br v12 b6() | b7()
@source nextln: b6()
@source nextln: Add
@source nextln: Mul
@opt check: br v10 b2() | b9()
@opt nextln: b2()
@opt nextln: Add
@opt nextln: jump b3
@opt check: br v11 b4() | b8()
@opt nextln: b4()
@opt nextln: Mul
@opt nextln: jump b5
@opt check: br v12 b6() | b7()
@opt nextln: b6()
@opt nextln: Add
@opt nextln: store
@run 3 4 2 10 -> 3 | aa aa aa aa | 25 00 00 00
@run 2 1 3 -7 -> 2 | aa aa aa aa | 02 00 00 00
@run 3 0 2 10 -> 3 | aa aa aa aa | aa aa aa aa
@run 3 4 0 10 -> 3 | aa aa aa aa | aa aa aa aa
