fn main out:ptr value:i32 -> i32
  store out value
  loaded = load i32 out
  ret loaded
@opt check: store
@opt not: load
@opt check: ret
@run 7 -> 7 | aa aa aa aa | 07 00 00 00

---

fn main out:ptr value:i32 fail:i32 -> i32
  store out value
  ignored = rust_call identity_or_error value fail
  loaded = load i32 out
  zero = const 0
  store out zero
  ret loaded
@opt check: store
@opt nextln: rust_call identity_or_error
@opt nextln: load I32
@opt check: store
@isel check: store.I32
@isel check: rust_call identity_or_error
@isel check: store.I32
@run 7 0 -> 7 | aa aa aa aa | 00 00 00 00
@run 7 5 -> !rust_panic | aa aa aa aa | 07 00 00 00
# Native code reports the import's own trap code, not a generic failure.
@run 7 6 -> !abi | aa aa aa aa | 07 00 00 00
@run 7 1 -> !bounds | aa aa aa aa | 07 00 00 00

---

# Calls with the same descriptor and arguments still have independent effects.
# A different descriptor with the same signature must resolve its own symbol.
fn main value:i32 -> i32
  zero = const 0
  first = rust_call identity_or_error value zero
  unused = rust_call identity_or_error value zero
  second = rust_call double value zero
  result = add first second
  ret result
@opt check: rust_call identity_or_error
@opt check: rust_call identity_or_error
@opt check: rust_call double
@run 7 -> 21
@run -3 -> -9

---

fn main out:ptr a:i32 b:i32 c:i32 d:i32 -> i32
  store out a
  unused = rust_packet_call sum4 a b c d
  loaded = load i32 out
  ret loaded
@opt check: store
@opt check: rust_packet_call sum4
@opt check: load I32
@isel check: store_packet_word 0
@isel check: store_packet_word 4
@isel check: store_packet_word 8
@isel check: store_packet_word 12
@isel check: rust_packet_call sum4
@run 1 2 3 4 -> 1 | aa aa aa aa | 01 00 00 00
